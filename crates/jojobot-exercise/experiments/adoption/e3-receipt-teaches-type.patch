diff -ruN a/crates/jojobot-exercise/tests/adoption_e3.rs b/crates/jojobot-exercise/tests/adoption_e3.rs
--- a/crates/jojobot-exercise/tests/adoption_e3.rs
+++ b/crates/jojobot-exercise/tests/adoption_e3.rs
@@ -0,0 +1,80 @@
+//! **Experiment E3 only: the receipt of a write teaches the shipped date types,
+//! once per session, when a date is sent under a key no declared type names.**
+//!
+//! Applied with the patch that makes it true, to a throwaway export, and never
+//! to main.
+
+use jojobot_exercise::room::{Room, server_binary};
+use jojobot_exercise::surface::Surface;
+use serde_json::{Value, json};
+
+async fn session() -> (Room, Surface, String) {
+    let (room, surface) = Room::open_with_client(&server_binary().expect("a jojobot binary"))
+        .await
+        .expect("a room");
+    let booted = surface
+        .must("start_here", json!({"bot": "assistant", "brief": true}))
+        .await
+        .expect("the shipped identity boots");
+    let sid = booted["session"]["sid"]
+        .as_str()
+        .expect("a sid")
+        .to_string();
+    surface
+        .call(
+            "add_entity",
+            json!({"kind": "thing", "handle": "floor-pump", "name": "The Floor Pump",
+                   "source": "user-named", "sid": sid}),
+        )
+        .await;
+    (room, surface, sid)
+}
+
+/// What the receipt of one capture taught, as text.
+async fn taught_by(surface: &Surface, sid: &str, fields: Value) -> String {
+    let answer = surface
+        .call(
+            "capture",
+            json!({"subject": "thing:floor-pump", "content": "a claim", "provenance": "testimony",
+                   "fields": fields, "sid": sid}),
+        )
+        .await;
+    let body: Value = serde_json::from_str(&answer).expect("the receipt is json");
+    body["teaching"].to_string()
+}
+
+#[tokio::test]
+async fn a_date_under_an_undeclared_key_teaches_the_shipped_types_once() {
+    let (_room, surface, sid) = session().await;
+    let first = taught_by(&surface, &sid, json!({"needed_by": "2026-10-20"})).await;
+    assert!(
+        first.contains("runs_out") && first.contains("decide_by"),
+        "the first such write teaches the shipped keys: {first}",
+    );
+    let second = taught_by(&surface, &sid, json!({"closed_until": "2026-10-21"})).await;
+    assert!(
+        !second.contains("runs_out"),
+        "the teaching fires once per session: {second}",
+    );
+}
+
+#[tokio::test]
+async fn a_shipped_key_or_a_non_date_teaches_nothing_and_spends_nothing() {
+    let (_room, surface, sid) = session().await;
+    let shipped = taught_by(&surface, &sid, json!({"runs_out": "2026-11-03"})).await;
+    assert!(
+        !shipped.contains("decide_by"),
+        "a shipped key was taught about: {shipped}"
+    );
+    let text = taught_by(&surface, &sid, json!({"nickname": "pumpy"})).await;
+    assert!(
+        !text.contains("decide_by"),
+        "a non-date was taught about: {text}"
+    );
+    // **The one teaching was not spent on either call above.**
+    let invented = taught_by(&surface, &sid, json!({"needed_by": "2026-10-20"})).await;
+    assert!(
+        invented.contains("decide_by"),
+        "the teaching was spent on a call that did not fire it: {invented}",
+    );
+}
