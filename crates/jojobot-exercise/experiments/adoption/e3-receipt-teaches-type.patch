+
+/// **Experiment E3 only: a date under a key no declared type names.**
+pub(crate) const UNDECLARED_DATE_DOMAIN: &str = "undeclared-date";
+
+pub(crate) const UNDECLARED_DATE_TEACHING: &str = "A date you sent sits under a key no declared \
+    type names. Some shipped types already say what a date is for, and a thing carrying their \
+    key is what the questions about what is owed and late read: runs-out (key runs_out) is the \
+    day something runs out — a supply, a subscription, a membership, whatever runs out; \
+    decide-by (key decide_by) is the day a decision has to be made by — a project, a plan, an \
+    offer with a window; trip (keys leaves_on and returns_on, with departs_from and arrives_at) \
+    is when somebody is away; entitlement (keys valid_from and valid_until, with admits) is the \
+    window something admits somebody to. If one of these is what you meant, update_fact the \
+    record to set that key and clear_fields the other. If none is, nothing here is wrong: the \
+    write stands as sent.";
+
+impl Jojobot {
+    /// **Whether a write sent a date-shaped value under a key no declared type
+    /// names.** The test is the shape of the value and the absence of the key
+    /// from every declaration; it judges nothing about what the key means. A
+    /// store that cannot say what is declared answers `false`.
+    pub(crate) async fn sent_a_date_under_an_undeclared_key(
+        &self,
+        sent: &std::collections::BTreeMap<String, String>,
+    ) -> bool {
+        let Ok(types) = self.memory.declared_types().await else {
+            return false;
+        };
+        sent.iter().any(|(key, value)| {
+            value.trim().parse::<jiff::civil::Date>().is_ok()
+                && !types
+                    .iter()
+                    .any(|declared| declared.fields.iter().any(|field| &field.key == key))
+        })
+    }
+}
