#!/usr/bin/env python3
"""Keep an agent that called wrap_session from accepting another prompt (rule 788)."""

from datetime import datetime, timezone
import json
import os
from pathlib import Path
import sys


def main():
    event = json.load(sys.stdin)
    if event["tool_name"] not in (
        "mcp__jojobot__wrap_session",
        "mcp__claude_ai_jojobot__wrap_session",
    ):
        return
    agent = os.environ.get("PASEO_AGENT_ID")
    if not agent:
        print("PASEO_AGENT_ID is missing; the finished session was not marked.", file=sys.stderr)
        return
    kept = {"agent": agent, "wrapped_at": datetime.now(timezone.utc).isoformat()}
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    mark = state / "jojobot/finished" / agent
    mark.parent.mkdir(parents=True, exist_ok=True)
    mark.write_text(json.dumps(kept) + "\n")


if __name__ == "__main__":
    main()
