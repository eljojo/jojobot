#!/usr/bin/env python3
"""Keep a successful jojobot wrap from accepting another prompt (rule 788)."""

import json
import os
from pathlib import Path
import sys


def main():
    agent = os.environ.get("PASEO_AGENT_ID")
    if not agent:
        return
    event = json.load(sys.stdin)
    response = event["tool_response"]
    if response.get("isError"):
        return
    receipt = response.get("structuredContent")
    if receipt is None:
        for block in response.get("content", []):
            if block.get("type") == "text":
                try:
                    receipt = json.loads(block["text"])
                except json.JSONDecodeError:
                    continue
                break
    if not isinstance(receipt, dict):
        return
    session = receipt.get("session", {})
    if session.get("state") != "wrapped":
        return
    kept = {"run": session["id"], "wrapped_at": receipt["entry"]["at"]}
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    mark = state / "jojobot/finished" / agent
    mark.parent.mkdir(parents=True, exist_ok=True)
    mark.write_text(json.dumps(kept) + "\n")


if __name__ == "__main__":
    main()
