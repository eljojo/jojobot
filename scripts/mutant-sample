#!/usr/bin/env python3
"""**Run the mutation sample, and record which mutants a lane kills.**

    scripts/mutant-sample --check
    scripts/mutant-sample [--from N] [--count M] [--baseline-run ID] -- <command...>

`--check` validates the manifest and mutates nothing; every run does it first and
refuses on a problem. The workflow runs it before any lane.

Reads `crates/jojobot-exercise/ledger/mutants.tsv` (file, from, to), and for each
mutant in the slice runs `scripts/sabotage <file> <from> <to> -- <command...>`.
The killed set of a lane is the set of mutants the lane reddens; a lane that
replaces another must kill the same set (rule 767: no coverage lost).

The lane runs once unmutated before the first mutant. A lane that fails then
stops the sample with exit 3, before any mutation and with nothing recorded:
its kills would not be kills.

**`--baseline-run ID` stands a pull-request run's job in for that baseline.** The
job is the lane run unmutated on the same commit, and it costs the sample about an
hour it has no need to spend again: a runner kills any job at 2h15m. ID is the
run's forge id. The sample refuses, with exit 2 and before any mutation, unless
the run is on this checkout's commit, is of `pull-request.yml`, and its job for
the lane (`check` for `make check`, `rooms` for `make rooms`) succeeded. The forge
is read through scripts/wait-run, so WAIT_RUN_API or a runner's own context names
it. Any other lane has no such job and is refused.

The verdict of each mutant is the word `scripts/sabotage` prints: RED (killed),
GREEN (survived), or a refusal or a break that does not build (neither colour,
counted apart). One line per mutant goes to stdout and to
`target/mutants/killed.tsv`: index, file, verdict. The exit code is 0 when every
mutant gave a verdict, and 1 when the tool refused any; a surviving mutant is a
finding for the ledger, not a failure of this tool.

This runs a lane once per mutant, so it never runs on a dev host: the
`mutants` workflow runs it.
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys

# A test of this tool points it at a manifest of its own, so that a mutation of a
# listed site cannot change what the test sees.
MANIFEST = os.environ.get(
    "MUTANT_MANIFEST", "crates/jojobot-exercise/ledger/mutants.tsv"
)
OUT = "target/mutants/killed.tsv"
USAGE = "usage: scripts/mutant-sample [--from N] [--count M] [--baseline-run ID] -- <command...>"
# The pull-request job that runs a lane unmutated, by the lane's command.
BASELINE_JOBS = {("make", "check"): "check", ("make", "rooms"): "rooms"}


def rows(path):
    with open(path, encoding="utf-8") as handle:
        lines = handle.read().splitlines()[1:]
    return [line.split("\t") for line in lines if line]


def verdict_of(output):
    """The word the sabotage tool ends on, or `refused`."""
    found = re.findall(r"^SABOTAGE VERDICT (RED|GREEN)", output, re.M)
    if found:
        return found[-1]
    if "SABOTAGE REFUSED" in output:
        return "refused"
    if "SABOTAGE VERDICT DID NOT COMPILE" in output:
        return "unbuilt"
    return "refused"


def problems(sample):
    """**What is wrong with the manifest, before any mutation is applied.**

    This check lives here and not in a test of the measured lanes: a test that
    reads the sites would fail under every mutant, and the lane would record a
    kill that no behavioural oracle made. Each file must exist, each `from` text
    must occur in it exactly once (the tool refuses any other count), each `to`
    must differ, and the sample holds about thirty.
    """
    found = []
    for file, old, new in sample:
        if old == new:
            found.append(f"{file}: to equals from: {old}")
            continue
        try:
            with open(file, encoding="utf-8") as handle:
                count = handle.read().count(old)
        except OSError as error:
            found.append(f"{file}: {error}")
            continue
        if count != 1:
            found.append(f"{file}: {count} sites for: {old}")
    if len(sample) < 30:
        found.append(f"the sample holds about thirty mutants, not {len(sample)}")
    return found


def wait_run():
    """scripts/wait-run, loaded as a module: the one reader of the forge."""
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "wait-run")
    loader = importlib.machinery.SourceFileLoader("wait_run", path)
    spec = importlib.util.spec_from_loader("wait_run", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def baseline_refusal(run_id, command):
    """**Why this run does not stand in for the baseline, or None when it does.**"""
    job_name = BASELINE_JOBS.get(tuple(command))
    if job_name is None:
        return f"no pull-request job runs `{' '.join(command)}`"
    wr = wait_run()
    if not wr.API:
        return "WAIT_RUN_API is not set and this is not a runner"
    head = subprocess.run(
        ["git", "rev-parse", "HEAD"], capture_output=True, text=True, check=True
    ).stdout.strip()
    try:
        found = None
        for page in range(1, wr.PAGES + 1):
            runs = wr.runs_of(head_sha=head, page=page)
            found = next((run for run in runs if run["id"] == run_id), None)
            if found or len(runs) < wr.PAGE:
                break
        if found is None:
            return f"run {run_id} is not among the runs of {head[:9]}"
        if found["commit_sha"] != head:
            return f"run {run_id} is on {found['commit_sha'][:9]}, not on {head[:9]}"
        if found["workflow_id"] != "pull-request.yml":
            return f"run {run_id} is a run of {found['workflow_id']}, not of pull-request.yml"
        jobs = json.loads(wr.fetch(f"/actions/runs/{run_id}/jobs"))
    except (OSError, ValueError, KeyError, wr.Gone) as error:
        return f"the forge could not be read: {error}"
    job = next((job for job in jobs if job.get("name") == job_name), None)
    if job is None or job.get("status") != "success":
        status = job.get("status") if job else "absent"
        return f"job {job_name} of run {run_id} is {status}, not success"
    return None


def main(argv):
    if argv == ["--check"]:
        found = problems(rows(MANIFEST))
        for line in found:
            print(line, file=sys.stderr)
        if not found:
            print(f"mutants: ok - {len(rows(MANIFEST))} sites, each unique")
        return 1 if found else 0
    if "--" not in argv:
        print(USAGE, file=sys.stderr)
        return 2
    split = argv.index("--")
    options, command = argv[:split], argv[split + 1 :]
    if not command:
        print(USAGE, file=sys.stderr)
        return 2
    start, count, baseline_run = 0, None, None
    it = iter(options)
    for option in it:
        if option == "--from":
            start = int(next(it))
        elif option == "--count":
            count = int(next(it))
        elif option == "--baseline-run":
            baseline_run = int(next(it))
        else:
            print(USAGE, file=sys.stderr)
            return 2
    sample = rows(MANIFEST)
    found = problems(sample)
    if found:
        print("\n".join(found), file=sys.stderr)
        return 2
    # A lane that is red unmutated reads every mutant as killed, so the sample
    # runs it once untouched and refuses before any mutation when it fails.
    if baseline_run is not None:
        why = baseline_refusal(baseline_run, command)
        if why:
            print(f"baseline-run: refused: {why}", file=sys.stderr)
            return 2
        baseline = None
    else:
        baseline = subprocess.run(command, capture_output=True, text=True)
    if baseline is not None and baseline.returncode != 0:
        print(
            f"baseline: the lane is red unmutated (exit {baseline.returncode}): "
            + " ".join(command)
            + "\n"
            + (baseline.stdout + baseline.stderr)[-2000:],
            file=sys.stderr,
        )
        return 3
    chosen = list(enumerate(sample))[start : None if count is None else start + count]
    os.makedirs(os.path.dirname(OUT), exist_ok=True)
    refused = 0
    with open(OUT, "a", encoding="utf-8") as record:
        for index, (file, old, new) in chosen:
            run = subprocess.run(
                ["scripts/sabotage", file, old, new, "--", *command],
                capture_output=True,
                text=True,
            )
            word = verdict_of(run.stdout + run.stderr)
            if word in ("refused", "unbuilt"):
                refused += 1
            line = f"{index}\t{file}\t{word}"
            print(line, flush=True)
            record.write(line + "\n")
            record.flush()
    return 1 if refused else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
