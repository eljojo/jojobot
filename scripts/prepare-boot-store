#!/usr/bin/env python3
"""Grow the store the boot measures run on, once per grower. CI only; no dump enters git.

The boot_measures cases need a store of production's size, and growing one through
the server's tools takes about half an hour. This script grows it on a cache miss
and copies the cached dump into BOOT_STORE_DIR on every run, so the cases only
restore it.

The cache key covers the recorder, the workspace sources and embedded inputs it
compiles, and the toolchain, beside the commit of the upgrade fixture it starts
from. A change to an input records again; a cache miss never skips the cases.
"""
import fcntl
import hashlib
import os
from pathlib import Path
import shutil
import signal
import subprocess
import tempfile
import time


# The grow alone took 1,137 s on the first run with no facts; facts and the restore
# come on top. A waiter holds out longer than the build it waits for.
# STOPGAP (2026-11-17) until the dev-loop line keys the grown store off the
# crates' source: with a cache miss per source change and several lines growing at once the
# grow took 4,174 s. Take this back to what one grow needs when the key fix lands.
BUILD_TIMEOUT = 6000
LOCK_TIMEOUT = BUILD_TIMEOUT + 300
# What the recorder compiles: the boot_measures test of `jojobot`, the crates it
# links, and the files those crates embed from outside `src`. A crate it does not
# link is not an input; UNLINKED_CRATES names those, so a crate added later has
# to be weighed (a test holds both lists to the checkout).
GROWER_INPUTS = (
    "scripts/prepare-boot-store",
    "scripts/refresh-upgrade-fixture",
    "crates/jojobot/tests/boot_measures.rs",
    "Cargo.toml",
    "Cargo.lock",
    "rust-toolchain.toml",
    "flake.nix",
    "flake.lock",
    "crates/jojobot/Cargo.toml",
    "crates/jojobot/src/**/*",
    "crates/jojobot-adapters/Cargo.toml",
    "crates/jojobot-adapters/build.rs",
    "crates/jojobot-adapters/src/**/*",
    "crates/jojobot-adapters/migrations/*.sql",
    "crates/jojobot-domain/Cargo.toml",
    "crates/jojobot-domain/src/**/*",
    "crates/jojobot-domain/data/**/*",
    "crates/jojobot-exercise/Cargo.toml",
    "crates/jojobot-exercise/src/**/*",
    "crates/jojobot-forward/Cargo.toml",
    "crates/jojobot-forward/src/**/*",
    "crates/jojobot-mcp/Cargo.toml",
    "crates/jojobot-mcp/build.rs",
    "crates/jojobot-mcp/src/**/*",
    "crates/jojobot-mcp/release-notes/**/*.md",
    "crates/jojobot-mcp/served-texts/**/*",
    "crates/jojobot-ports/Cargo.toml",
    "crates/jojobot-ports/src/**/*",
    "crates/jojobot-query-api/Cargo.toml",
    "crates/jojobot-query-api/src/**/*",
    "crates/jojobot-ui/Cargo.toml",
    "crates/jojobot-ui/src/**/*",
)
UNLINKED_CRATES = ("jojobot-bar", "jojobot-roster")
FILES = ("doltdump.sql", "grown.txt", "dump.sha256", "key.txt")


def lock_cache(lock):
    deadline = time.monotonic() + LOCK_TIMEOUT
    while True:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if time.monotonic() >= deadline:
                raise SystemExit(f"boot store refused: lock wait exceeded {LOCK_TIMEOUT:g}s")
            time.sleep(0.05)


def grower_digest():
    digest = hashlib.sha256()
    # Sorted paths make additions, removals and renames inputs too, independently
    # of filesystem enumeration order. A file matched twice is hashed only once.
    paths = set()
    for pattern in GROWER_INPUTS:
        found = {path for path in Path(".").glob(pattern) if path.is_file()}
        # A pattern that finds nothing names a path that was renamed or removed,
        # and the key would drop it without a word.
        if not found:
            raise SystemExit(f"boot store refused: input pattern matches nothing: {pattern}")
        paths |= found
    for path in sorted(paths):
        digest.update(path.as_posix().encode() + b"\0")
        digest.update(path.read_bytes())
        digest.update(b"\0")
    return digest.hexdigest()[:16]


def upgrade_fixture_commit():
    fixture = Path(os.environ["UPGRADE_FIXTURE_DIR"]).resolve()
    try:
        return (fixture / "ref.txt").read_text().strip()
    except OSError:
        raise SystemExit("boot store refused: the upgrade fixture is not prepared (no ref.txt)")


def complete(directory, key):
    try:
        dump = (directory / "doltdump.sql").read_bytes()
        return (
            bool(dump)
            and (directory / "key.txt").read_text().strip() == key
            and bool((directory / "grown.txt").read_text().strip())
            and (directory / "dump.sha256").read_text().strip() == hashlib.sha256(dump).hexdigest()
        )
    except OSError:
        return False


def record(directory):
    env = dict(os.environ, BOOT_STORE_DIR=str(directory))
    command = [
        "scripts/refresh-upgrade-fixture", upgrade_fixture_commit(), str(directory),
    ]
    with subprocess.Popen(command, env=env, start_new_session=True) as build:
        try:
            code = build.wait(timeout=BUILD_TIMEOUT)
        except subprocess.TimeoutExpired:
            for sig in (signal.SIGTERM, signal.SIGKILL):
                try:
                    os.killpg(build.pid, sig)
                except ProcessLookupError:
                    pass
                try:
                    build.wait(timeout=5)
                    break
                except subprocess.TimeoutExpired:
                    pass
            raise SystemExit(f"boot store refused: growing exceeded {BUILD_TIMEOUT:g}s")
        if code:
            raise SystemExit(f"boot store refused: the recorder exited {code}")


def main():
    if os.environ.get("GITHUB_ACTIONS") != "true":
        raise SystemExit("boot store refused: the grown store is made only in CI")
    key = upgrade_fixture_commit() + "-" + grower_digest()
    output = Path(os.environ["BOOT_STORE_DIR"]).resolve()
    cache_home = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
    parent = cache_home / "jojobot" / "boot-stores"
    parent.mkdir(parents=True, exist_ok=True)
    cache = parent / key
    with (parent / "grow.lock").open("w") as lock:
        lock_cache(lock)
        if complete(cache, key):
            print(f"boot store: cache hit; key {key}", flush=True)
        else:
            print(f"boot store: cache miss; growing key {key}", flush=True)
            with tempfile.TemporaryDirectory(prefix="grow-", dir=parent) as temporary:
                recording = Path(temporary) / "store"
                recording.mkdir()
                record(recording)
                dump = (recording / "doltdump.sql").read_bytes()
                (recording / "dump.sha256").write_text(hashlib.sha256(dump).hexdigest() + "\n")
                (recording / "key.txt").write_text(key + "\n")
                if not complete(recording, key):
                    raise SystemExit("boot store refused: the recording is incomplete")
                if cache.exists():
                    shutil.rmtree(cache)
                recording.rename(cache)
        output.mkdir(parents=True, exist_ok=True)
        for name in FILES:
            shutil.copyfile(cache / name, output / name)
    print(f"boot store: ready at {output}; key {key}", flush=True)


if __name__ == "__main__":
    main()
