#!/usr/bin/env python3
"""Run the memory job's case, the case of the boot_measures binary that the check lane
ignores: the import boot, the boot over its snapshot, the boot with none, and the
whole-day replay on that last server. CI's memory job runs it; `make memory` is the
same command.

The case boots the current binary over the production-sized store (BOOT_STORE_DIR);
the day makes every entry of a day through the running server too. It writes its
numbers to target/bar/boot-measures.log. It is a measurement, not a test (rule 810),
and takes longer than the check lane allows one test binary, so this runs it alone,
with a deadline of its own (MEMORY_DAY_DEADLINE_SECONDS, 4800 by default).

With BAR_BUNDLE the binary is the one the bundle holds for the check lane, run
where the bar runs it: in its package's directory, with CARGO_MANIFEST_DIR and the
server beside it. Without it, cargo builds and runs it.

The run is red when a case failed, when the deadline ended it (exit 124), or when
not every case ran: a filter that selects nothing exits 0 and would read as green.
"""
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import time

# One measurement, not a test (rule 810): the import boot that prepares the store, the boot
# over its snapshot, the boot with none, and the day replayed on that last server. One case,
# so the store is restored and the import run once: two cases each did both, and a loaded
# runner took the pair past the deadline.
CASES = [
    "memory_report::the_servers_memory_after_a_replayed_day",
]
# Room for the case on a loaded runner: the day took 1,756 to 2,000 s on a free runner and
# about 3,450 s (1.5 entries a second) on a loaded one, and the three boots and the import
# before it under 300 s. The memory job is stopped at 100 minutes, which leaves 20 for the
# runner cleanup, the downloads and the verdict.
# TEMPORARY(9.3.4) `q-934-jemalloc-memory-measurement`: this deadline and the job's timeout are
# sized to glibc's day on a loaded runner; lower both when jemalloc is in the binary (the day
# took 1,450 s against 2,666 s on glibc).
DEADLINE = int(os.environ.get("MEMORY_DAY_DEADLINE_SECONDS", "4800"))
# Rule 800's bound on the server's own memory, 4 GiB. It is not the unit's memoryMax,
# which a later rule moves.
LIMIT_MIB = 4096.0
BAR = Path("target/bar")
# Production's first boot at 9.3.3: the Rust process's resident memory the first sample after
# serving began (3.47 GiB, VictoriaMetrics process_resident_memory_bytes, 2026-11-12).
PRODUCTION_FIRST_BOOT_MIB = 3553.0
# The share of production's first-boot reading under which the store is too small for the bound
# to speak for production: the verdict says so.
SIZED_SHARE = 75


def command():
    """The command to run, the directory to run it in and its environment."""
    # One thread: the cases boot a server each and each reads its own process memory.
    arguments = ["--ignored", "--exact", *CASES, "--nocapture", "--test-threads=1"]
    manifest = os.environ.get("BAR_BUNDLE")
    if not manifest:
        return (
            ["cargo", "test", "-p", "jojobot", "--features", "room-harness",
             "--test", "boot_measures", "--locked", "--", *arguments],
            None,
            dict(os.environ),
        )
    manifest = json.loads(Path(manifest).read_text())
    held = [exe for exe in manifest["exes"]
            if exe["lane"] == "check" and exe["describes"] == "tests/boot_measures.rs"]
    if len(held) != 1:
        sys.exit(f"memory-day: the bundle holds {len(held)} boot_measures binaries in the check lane, not one")
    root = Path(manifest["root"])
    binary = root / held[0]["path"]
    directory = root / held[0]["dir"]
    environment = dict(os.environ, CARGO_MANIFEST_DIR=str(directory))
    # `target/<profile>/deps/<binary>` sits beside the server it spawns.
    environment.setdefault("JOJOBOT_BIN", str(binary.parent.parent / "jojobot"))
    return [str(binary), *arguments], directory, environment


def descendants(pid):
    """Every process below `pid`, read from /proc."""
    children = {}
    for entry in Path("/proc").iterdir():
        if not entry.name.isdigit():
            continue
        try:
            # The command name may hold spaces and brackets; the fields follow its `)`.
            fields = (entry / "stat").read_text().rsplit(")", 1)[1].split()
            # A zombie is dead and holds nothing to kill; counting it keeps the tree
            # non-empty on a host where nothing reaps an orphan promptly.
            if fields[0] != "Z":
                children.setdefault(int(fields[1]), []).append(int(entry.name))
        except (OSError, IndexError, ValueError):
            continue
    found, pending = [], [pid]
    while pending:
        for child in children.get(pending.pop(), []):
            found.append(child)
            pending.append(child)
    return found


def stop_tree(pid):
    """Kill the binary and everything it started. The case starts the server and its
    store in process groups of their own, which a kill of the binary's group does not
    reach, and a process whose parent has died is nobody's child, so the tree is read
    and killed before the binary's own group is."""
    for _ in range(5):
        below = descendants(pid)
        if not below:
            break
        for victim in below:
            try:
                os.kill(victim, signal.SIGKILL)
            except ProcessLookupError:
                pass
        # Let a child that a victim started as it died show in the next read.
        time.sleep(0.2)
    os.killpg(pid, signal.SIGKILL)


def larger(a, b):
    """The larger of two numbers written as text, kept as written; None is smaller."""
    if a is None or (b is not None and float(b) > float(a)):
        return b
    return a


def report_lines(measures, start):
    """The report lines this invocation wrote. The cases append to the report and every
    invocation in a checkout adds to it, so the verdict reads from where the file stood
    when this one began; the earlier lines stay in the file as its history."""
    if not measures.exists():
        return []
    data = measures.read_bytes()
    # A file shorter than it was has been replaced: all of it is this run's.
    text = data[start:] if start <= len(data) else data
    return [line for line in text.decode(errors="replace").splitlines()
            if line.startswith("memory-report ")]


def measured(lines):
    """The numbers rule 800 bounds, in MiB as the report writes them, and the import
    boot beside them. The import boot (the larger if the job makes more than one) prepares
    the store and is printed beside production's reading, not bound. Bound are the
    boots production can pay on the import-done store: the no-snapshot boot (the larger
    if the job makes more than one; the day runs on it), and the second boot over the
    snapshot the first one left; and its resident memory at the end of the day, and the
    most it held in the day. Production is killed at its peak and not where it settles, so the
    last is the larger of the day's highest sample and the process's own peak. None for
    a number these lines do not hold."""
    boot = boot_resident = second = no_snapshot = day = highest = None
    for line in lines:
        found = re.search(r"^memory-report boot: .*?server peak ([0-9.]+) MiB", line)
        boot = larger(boot, found.group(1) if found else None)
        # Production's reading is one instant, the resident memory after its boot, so
        # the share is taken from this run's resident memory after the boot, the larger
        # of the two the job makes.
        found = re.search(r"^memory-report boot: .*?server resident after boot ([0-9.]+) MiB", line)
        boot_resident = larger(boot_resident, found.group(1) if found else None)
        found = re.search(r"^memory-report second boot: .*?server peak ([0-9.]+) MiB", line)
        second = larger(second, found.group(1) if found else None)
        found = re.search(r"^memory-report no-snapshot boot: .*?server peak ([0-9.]+) MiB", line)
        no_snapshot = larger(no_snapshot, found.group(1) if found else None)
        found = re.search(r"^memory-report day: .*?server resident ([0-9.]+) MiB at the end", line)
        day = found.group(1) if found else day
        for pattern in (r"([0-9.]+) MiB at the most", r"; peak ([0-9.]+) MiB"):
            found = re.search(r"^memory-report day: .*?" + pattern, line)
            highest = larger(highest, found.group(1) if found else None)
    return boot, boot_resident, second, no_snapshot, day, highest


def comparison(lines):
    """What the import boot is compared to, with the day production's bytes were read,
    taken from the calibration line the case wrote (the last, if there are several): the
    day is spelled once, in the case, and never again here."""
    day = None
    for line in lines:
        found = re.search(r"^memory-report calibration: .*production's totals read on (\S+)$", line)
        day = found.group(1) if found else day
    if day is None:
        return "the report names no day production's bytes were read"
    return f"store sized to production's bytes read {day}"


def main():
    BAR.mkdir(parents=True, exist_ok=True)
    log = BAR / "memory.log"
    argv, directory, environment = command()
    measures = BAR / "boot-measures.log"
    start = measures.stat().st_size if measures.exists() else 0
    began = time.monotonic()
    with log.open("w") as out:
        child = subprocess.Popen(argv, cwd=directory, env=environment, stdout=out,
                                 stderr=subprocess.STDOUT, start_new_session=True)
        try:
            code = child.wait(timeout=DEADLINE)
        except subprocess.TimeoutExpired:
            stop_tree(child.pid)
            child.wait()
            code = 124
    wall = round(time.monotonic() - began)
    text = log.read_text(errors="replace")
    # What the case measured, in the job's own log: the rest is in memory.log.
    lines = report_lines(measures, start)
    for line in lines:
        print(line)
    if code == 124:
        verdict = f"memory-day: TIMED OUT after {wall} s; the deadline is {DEADLINE} s and the run was killed"
    elif code != 0:
        verdict = f"memory-day: FAILED with exit {code} after {wall} s; the output is in {log}"
    elif not re.search(rf"test result: ok\. {len(CASES)} passed", text):
        verdict = f"memory-day: FAILED, not every case ran: {' and '.join(CASES)} were not all found in the binary"
        code = 1
    else:
        boot, boot_resident, second, no_snapshot, day, highest = measured(lines)
        missing = [name for name, number in (("import-boot peak", boot),
                                             ("no-snapshot-boot peak", no_snapshot),
                                             ("second-boot peak", second),
                                             ("resident memory after the day", day),
                                             ("highest memory in the day", highest))
                   if number is None]
        # The import boot prepares the store and is the calibration pair beside
        # production's own reading; it is not bound. The boots production can pay are.
        beside = ""
        share = None
        if boot is not None and boot_resident is not None:
            share = round(100 * float(boot_resident) / PRODUCTION_FIRST_BOOT_MIB)
            beside = (f"import boot resident {boot_resident} MiB (peak {boot} MiB), {share}% of "
                      f"production's {PRODUCTION_FIRST_BOOT_MIB:.0f} MiB ({comparison(lines)}), ")
        elif boot is not None:
            beside = f"import boot {boot} MiB, import boot share: not read, "
        numbers = (f"{beside}no-snapshot boot {no_snapshot} MiB, second-boot peak {second} MiB, "
                   f"resident after the day {day} MiB, highest in the day {highest} MiB")
        if missing:
            verdict = f"memory-day: FAILED after {wall} s: the report holds no {' and no '.join(missing)}"
            code = 1
        elif any(float(number) >= LIMIT_MIB for number in (no_snapshot, second, day, highest)):
            verdict = f"memory-day: OVER {LIMIT_MIB:.0f} MiB (4 GiB) after {wall} s: {numbers}"
            code = 3
        elif share is not None and share < SIZED_SHARE:
            # The bound speaks for boots of a store the size CI holds. A green line on a store
            # far smaller than production's must not read as the proof that production fits.
            verdict = (f"memory-day: ok after {wall} s, but the store is at {share}% of "
                       f"production's first-boot reading (under {SIZED_SHARE}%), so this does not "
                       f"show that production fits in 4 GiB: {numbers}, all under "
                       f"{LIMIT_MIB:.0f} MiB (4 GiB)")
        else:
            verdict = f"memory-day: ok after {wall} s: {numbers}, all under {LIMIT_MIB:.0f} MiB (4 GiB)"
    print(verdict)
    # The job prints this file as its last line: the run step carries
    # continue-on-error, so the job's status cannot say how the day went.
    (BAR / "memory-day.log").write_text(verdict + "\n")
    return code


if __name__ == "__main__":
    sys.exit(main())
