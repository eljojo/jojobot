#!/usr/bin/env python3
"""**Print the cases a run's logs show over a bound, and how many there are.**

    scripts/slow-tests RUN_ID [--over SECONDS]
    scripts/slow-tests --newest-main [--over SECONDS]

RUN_ID is the number `scripts/wait-run` prints after `run #`. A job's own log on
the forge holds only the bar's verdict block; the case lines are in the logs the
job uploads as its `bar-logs-<job>` artifact. The tool lists the run's artifacts
and reads each live `bar-logs-*` one the way `scripts/wait-run` reads the forge
(its WAIT_RUN_API, no credential), and takes every `test NAME ... ok <12.3s>` line
the report-time flag makes the harness print. The time is the case's own, so
compile time is not in it. A case that more than one job ran is counted once, with
the longest time any job saw and the job that saw it. The forge keeps an artifact
for seven days, so an older run reads as expired.

`--newest-main` takes the run itself: the newest successful run of a pull request into
main, the one that describes what is deployed (rule 759), that stopped in the last seven
days. With none, the last line
says nothing was counted, and no other run is read in its place: a branch run, or a
run of a pull request into a deploy branch, never stands for main.

Each case over the bound is printed, slowest first, as
`<seconds>s  <job>  <case>`, and the last line is
`slow tests over <bound> s: <count> (run #<id>)`. The bound is 60 seconds unless
`--over` names another (rule 651). A job whose artifact holds no timed case line,
or has expired, is named, because a count that skipped it would read low.

Exit code: 0 the run was read, or every artifact had expired (the last line says
nothing was counted, so the weekly step goes on to print the size), 1 no live artifact
held a timed case line (the count would say nothing), 4 no API root, or the run is not on the forge.
"""
import argparse
import datetime
import importlib.machinery
import importlib.util
import io
import json
import os
import re
import sys
import urllib.request
import zipfile

BOUND_SECONDS = 60.0
WEEK = datetime.timedelta(days=7)
TIMED = re.compile(r"^test (\S+) \.\.\. (?:ok|FAILED) <(\d+(?:\.\d+)?)s>$")


def wait_run():
    """scripts/wait-run as a module, so the forge is read the way it reads it."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "wait-run")
    loader = importlib.machinery.SourceFileLoader("wait_run", path)
    spec = importlib.util.spec_from_loader("wait_run", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def timed_cases(log):
    """Every (case, seconds) the log's lines say, in the order printed."""
    found = []
    for line in log.splitlines():
        hit = TIMED.match(line.strip())
        if hit:
            found.append((hit.group(1), float(hit.group(2))))
    return found


def slowest(jobs, bound):
    """The cases over `bound` across (job name, log) pairs: one entry for each case, with
    its longest time and the job that saw it, slowest first; and the jobs that held no
    timed line."""
    over = {}
    silent = []
    for name, log in jobs:
        cases = timed_cases(log)
        if not cases:
            silent.append(name)
        for case, seconds in cases:
            if seconds > bound and seconds > over.get(case, (0.0, ""))[0]:
                over[case] = (seconds, name)
    rows = sorted(over.items(), key=lambda row: (-row[1][0], row[0]))
    return [(seconds, job, case) for case, (seconds, job) in rows], silent


def artifact_logs(wr, run):
    """(job name, log text) for each live `bar-logs-*` artifact of the run, and the names of
    the jobs whose artifact has expired."""
    listed = json.loads(wr.fetch(f"/actions/runs/{run}/artifacts"))
    logs, expired = [], []
    for artifact in listed:
        name = artifact["name"]
        if not name.startswith("bar-logs-"):
            continue
        name = name[len("bar-logs-"):]
        if artifact.get("expired"):
            expired.append(name)
            continue
        url = f"{wr.API}/actions/artifacts/{artifact['id']}/zip"
        with urllib.request.urlopen(url, timeout=60) as answer:
            archive = zipfile.ZipFile(io.BytesIO(answer.read()))
        text = "\n".join(
            archive.read(entry).decode("utf-8", "replace")
            for entry in archive.namelist()
            if entry.endswith(".log")
        )
        logs.append((name, text))
    return logs, expired


def base_branch(run):
    """The branch a pull-request run's pull request targets, from the run's event payload
    (`pull_request.base.ref`), or None when the payload does not say. The pull-request
    workflow also runs for pull requests into deploy-* branches."""
    try:
        return json.loads(run["event_payload"])["pull_request"]["base"]["ref"]
    except (KeyError, TypeError, ValueError):
        return None


def newest_main(wr, now):
    """The id of the newest successful run of a pull request into main that stopped within
    the week before `now`, or None. A push to a branch is not one, and neither is a pull
    request into a deploy branch."""
    held = []
    for run in wr.runs_of(event="pull_request", status="success"):
        stopped = datetime.datetime.fromisoformat(run["stopped"])
        if (
            run.get("workflow_id") == "pull-request.yml"
            and (run.get("event") or run.get("trigger_event")) == "pull_request"
            and run.get("status") == "success"
            and base_branch(run) == "main"
            and now - WEEK <= stopped <= now
        ):
            held.append((stopped, run["id"]))
    return max(held)[1] if held else None


def main():
    ask = argparse.ArgumentParser(description="Cases a Forgejo run's logs show over a bound.")
    ask.add_argument("run", nargs="?",
                     help="the run's number, as scripts/wait-run prints it after run #")
    ask.add_argument("--newest-main", action="store_true",
                     help="read the newest successful pull-request run of the last week")
    ask.add_argument("--over", type=float, default=BOUND_SECONDS, help="seconds (default %(default)s)")
    args = ask.parse_args()
    wr = wait_run()
    if not wr.API:
        print("WAIT_RUN_API is not set: set it to the repository's API root", file=sys.stderr)
        sys.exit(4)
    if bool(args.run) == args.newest_main:
        ask.error("name a run or --newest-main, not both and not neither")
    bound = f"{args.over:g}"
    if args.newest_main:
        try:
            args.run = newest_main(wr, datetime.datetime.now(datetime.timezone.utc))
        except wr.Gone as err:
            print(f"the forge has nothing at {err}", file=sys.stderr)
            sys.exit(4)
        if args.run is None:
            print(f"slow tests over {bound} s: not counted "
                  "(no successful pull-request run in the last 7 days)")
            return
    try:
        logs, expired = artifact_logs(wr, args.run)
    except wr.Gone as err:
        print(f"the forge has nothing at {err}", file=sys.stderr)
        sys.exit(4)
    rows, silent = slowest(logs, args.over)
    for seconds, job, case in rows:
        print(f"{seconds:.1f}s  {job}  {case}")
    for name in silent:
        print(f"no timed case line in the logs of the {name} job")
    for name in expired:
        print(f"the logs of the {name} job have expired")
    if not logs and expired:
        # The weekly step runs this before `make size`; an exit here would lose the size.
        print(f"slow tests over {bound} s: not counted "
              f"(run #{args.run}: every job's logs have expired)")
        return
    if len(silent) == len(logs):
        print("no job's logs hold a timed case line: the count says nothing", file=sys.stderr)
        sys.exit(1)
    print(f"slow tests over {bound} s: {len(rows)} (run #{args.run})")


if __name__ == "__main__":
    main()
