#!/bin/sh
# Run a command with this checkout visible at one fixed absolute path.
#
#     ci-root <root> <command> [argument ...]
#
# Test binaries carry the absolute path of the checkout they were compiled in
# (`env!("CARGO_MANIFEST_DIR")`). A job on a host runner gets a checkout in a
# directory of its own, so a binary compiled by one job cannot find its files
# in another job's checkout. Every job of one pull-request run calls this with
# the same <root>, and the command then sees its own checkout at that path.
#
# The cargo target directory is fixed too: the binaries name the servers they
# spawn by absolute path, and a runner's own target directory differs from host
# to host. It is <root>/cargo-target. A job that compiles sets JOJOBOT_CI_CACHE
# to the runner's target directory, which is then mounted there, so the build
# is incremental as it was; a job that only runs binaries sets nothing, and the
# directory is filled from the bundle.
#
# The bind mount lives in a mount namespace private to this command, so two
# jobs on one host do not see each other's checkout. The command itself runs
# as the invoking user, not as root: a test about file permissions must not
# be answered by a user that no mode bits stop.
set -eu

root=$1
shift
here=$(pwd)
mkdir -p "$root"

# The directory <root> stays behind, empty. Removing it from here would also
# unmount it in the namespace of another job that holds it open.
JOJOBOT_CI_HERE=$here JOJOBOT_CI_ROOT=$root JOJOBOT_CI_UID=$(id -u) JOJOBOT_CI_GID=$(id -g) \
  unshare --user --map-root-user --mount sh -c '
    mount --bind "$JOJOBOT_CI_HERE" "$JOJOBOT_CI_ROOT" || exit 97
    cd "$JOJOBOT_CI_ROOT"
    mkdir -p "$JOJOBOT_CI_ROOT/cargo-target"
    if [ -n "${JOJOBOT_CI_CACHE:-}" ]; then
      mkdir -p "$JOJOBOT_CI_CACHE"
      mount --bind "$JOJOBOT_CI_CACHE" "$JOJOBOT_CI_ROOT/cargo-target" || exit 98
    fi
    export CARGO_TARGET_DIR="$JOJOBOT_CI_ROOT/cargo-target"
    # An sccache server resolves paths in the mount namespace it was started
    # in. A runner slot may name one server for every job it runs
    # (SCCACHE_SERVER_UDS), and that server outlives the job, so the next job
    # would send it paths of a checkout it cannot see. Every job runs a server
    # of its own on a socket inside its own checkout, which no other job can
    # reach, and the server stops soon after the job. The path is short: a
    # socket path holds at most 107 bytes.
    mkdir -p "$JOJOBOT_CI_ROOT/.ci"
    export SCCACHE_SERVER_UDS="$JOJOBOT_CI_ROOT/.ci/sccache.sock"
    export SCCACHE_IDLE_TIMEOUT=60
    exec unshare --user --map-user="$JOJOBOT_CI_UID" --map-group="$JOJOBOT_CI_GID" "$@"
  ' sh "$@"
