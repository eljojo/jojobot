#!/usr/bin/env python3
"""**Delete the forge branches whose work is already on main, or say which it would.**

    scripts/branch-prune            # a dry run: prints what it would delete, deletes nothing
    scripts/branch-prune --delete   # deletes, and logs every branch with its head

A branch is deleted when its head is an ancestor of `origin/main`, or when every
commit on it has a patch-equal commit on main (`git cherry` prints no `+`).

It never deletes:
  - `main`, a protected branch, or a name in HELD below;
  - a branch a card at working, reported, accepted or queued names: **this script
    cannot read the cards**, so a live run (`--delete`) is dispatched only by the
    engineering manager, after reading the dry-run list against the cards' branch
    fields and adding what the cards name to HELD;
  - the head of an open pull request, read from the forge;
  - a branch whose head was pushed less than a day ago, since a branch cut from
    main this morning is an ancestor of main and has no work on it yet. **The time
    is the push**, read from the forge's repository activity feed: the branch list
    gives only the head commit's date, and a branch cut from an old commit and
    pushed today looks old there. **A head with no push of it in the feed is held
    too**, because the feed cannot say how old it is, and so is a head whose name
    the feed shows deleted after that push: the branch was made again, and when
    is unknown. **Just before a delete the feed is read again**, and any event on
    the name since the first read refuses it, because a branch deleted and made
    again at the same head passes the lease;
  - a branch whose head this checkout does not hold: it cannot be judged.

Every deletion is logged as `deleted <name> <sha>`, so a branch can be pushed back
from its head. The script reads the forge with no credential; a deletion needs the
job's own token in TOKEN. **The deletion is a `git push` to `origin` with
`--force-with-lease` on the judged head**, which the forge refuses atomically when
the branch moved: a read before a delete cannot see a push that lands between the
two. It uses the credential the checkout left for `origin`. It needs a checkout that holds every branch head and
`origin/main` (`git fetch origin '+refs/heads/*:refs/remotes/origin/*'`).

The forge is named by GITHUB_API_URL and GITHUB_REPOSITORY, as on a runner.
"""
import datetime
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

# **Branches that stay whatever their state.** A name ending in `-` is a prefix.
# `main`, the release lines and every `em-` branch are reserved. The operator's
# own pull request heads are never touched, and they are not open pull requests
# now, so they are named here. `dev-sol-scratch-names-work` belongs to a card at
# work. This tuple is the one place to add a hold.
HELD = (
    "main",
    "deploy-",
    "em-",
    "dev-unreadable-922-work",
    "dev-unreadable-fix2-922-work",
    "dev-sol-scratch-names-work",
)
HOLD_NEWER_THAN = datetime.timedelta(days=1)
# Pages of 50 events the feed is read for; a push older than this is not found.
FEED_PAGES = 40


def forge(path, method="GET"):
    root = f"{os.environ['GITHUB_API_URL'].rstrip('/')}/repos/{os.environ['GITHUB_REPOSITORY']}"
    request = urllib.request.Request(root + path, method=method)
    if method != "GET":
        request.add_header("Authorization", f"token {os.environ['TOKEN']}")
    with urllib.request.urlopen(request, timeout=30) as answer:
        return answer.read().decode("utf-8", "replace")


def listed(path):
    """Every item of a paged list the forge answers."""
    found, page = [], 1
    while True:
        items = json.loads(forge(f"{path}{'&' if '?' in path else '?'}limit=50&page={page}"))
        if not items:
            return found
        found += items
        page += 1


def feed(newer_than=0):
    """The branch events of the forge's activity feed, newest first, as
    `(id, kind, name, head, when)`. Reading stops at the first event whose id is
    `newer_than` or older, so a second read costs the pages since the first."""
    for page in range(1, FEED_PAGES + 1):
        events = json.loads(forge(f"/activities/feeds?limit=50&page={page}"))
        if not events:
            return
        for event in events:
            if event["id"] <= newer_than:
                return
            ref = event.get("ref_name", "")
            if event.get("op_type") not in ("commit_repo", "delete_branch") or not ref.startswith(
                "refs/heads/"
            ):
                continue
            head = json.loads(event.get("content") or "{}").get("HeadCommit") or {}
            yield (
                event["id"],
                event["op_type"],
                ref[len("refs/heads/"):],
                head.get("Sha1"),
                datetime.datetime.fromisoformat(event["created"]),
            )


def pushes():
    """What the feed says about every branch: `(pushed, deleted, last)`.

    `pushed` is when each head was last pushed, `{(name, sha): datetime}`, and
    `deleted` is when each name was last deleted. `last` is the newest event id
    read. A head the feed does not show is absent, and absent is held.
    """
    pushed, deleted, last = {}, {}, 0
    for id_, kind, name, sha, when in feed():
        last = max(last, id_)
        if kind == "delete_branch":
            deleted[name] = max(deleted.get(name, when), when)
        else:
            pushed[(name, sha)] = max(pushed.get((name, sha), when), when)
    return pushed, deleted, last


def git(*args):
    return subprocess.run(["git", *args], capture_output=True, text=True)


def landed(sha):
    """How the work on this head is already on main, or None."""
    if git("merge-base", "--is-ancestor", sha, "origin/main").returncode == 0:
        return "ancestor of main"
    # `git cherry` skips a merge commit, so a branch holding one would read as
    # landed on the strength of the commits beside it.
    merges = git("rev-list", "--merges", f"origin/main..{sha}")
    if merges.returncode != 0 or merges.stdout.strip():
        return None
    cherry = git("cherry", "origin/main", sha)
    if cherry.returncode == 0 and not any(l.startswith("+") for l in cherry.stdout.splitlines()):
        return "every commit patch-equal on main"
    return None


def hold_reason(branch, open_heads, pushed, deleted, now):
    name = branch["name"]
    if branch.get("protected") or any(name == h or (h.endswith("-") and name.startswith(h)) for h in HELD):
        return "held name"
    if name in open_heads:
        return "head of an open pull request"
    stamp = pushed.get((name, branch["commit"]["id"]))
    if stamp is None:
        return "no push of this head in the forge's activity"
    # **A branch deleted after that push was made again**, and the feed does not
    # say when or whether anyone pushed it, so the old push says nothing about it.
    if name in deleted and deleted[name] >= stamp:
        return "deleted and made again since its last recorded push"
    if now - stamp < HOLD_NEWER_THAN:
        return "head pushed less than a day ago"
    if git("cat-file", "-e", branch["commit"]["id"] + "^{commit}").returncode != 0:
        return "head not in this checkout"
    return None


def delete(name, sha, last):
    """Delete a branch only if it still holds the head that was judged.

    Raises `Refused` when the branch moved, and `Failed` when the delete did not
    happen for any other reason. **The read is only an early refusal**: a push that
    lands after it is refused by the lease, which the forge checks as it deletes.
    """
    path = f"/branches/{urllib.parse.quote(name, safe='')}"
    current = json.loads(forge(path))["commit"]["id"]
    if current != sha:
        raise Refused(f"changed since judged: {name} was {sha}, now {current}")
    # **The feed was read before the loop began.** A branch deleted and made again
    # at the same head since then passes the lease, so any event on this name
    # newer than that read refuses the delete.
    # The hold is best-effort for a branch made again at a commit already on main:
    # the feed can trail the forge, so a recreation it has not shown yet is not
    # held. No commit is lost by it, because the lease below refuses a head that moved.
    if any(event[2] == name for event in feed(newer_than=last)):
        raise Refused(f"activity on {name} since judged")
    pushed = git(
        "push", f"--force-with-lease=refs/heads/{name}:{sha}", "origin", f":refs/heads/{name}"
    )
    if pushed.returncode == 0:
        return
    words = pushed.stderr.strip().splitlines()[-1:] or ["no reason given"]
    if "stale info" in pushed.stderr or "cannot lock ref" in pushed.stderr:
        raise Refused(f"changed since judged: {name} was {sha}: {words[0]}")
    raise Failed(words[0])


class Refused(Exception):
    pass


class Failed(Exception):
    pass


def main(argv):
    live = argv == ["--delete"]
    if argv not in ([], ["--delete"]):
        print(__doc__)
        return 2
    if live and not os.environ.get("TOKEN"):
        print("--delete needs the job's token in TOKEN", file=sys.stderr)
        return 2
    now = datetime.datetime.now(datetime.timezone.utc)
    open_heads = {p["head"]["ref"] for p in listed("/pulls?state=open")}
    pushed, deleted_at, last = pushes()
    deleted = held = kept = failed = 0
    for branch in listed("/branches"):
        name, sha = branch["name"], branch["commit"]["id"]
        why = hold_reason(branch, open_heads, pushed, deleted_at, now)
        if why:
            held += 1
            print(f"hold {name} {sha}: {why}")
            continue
        how = landed(sha)
        if not how:
            kept += 1
            print(f"keep {name} {sha}: work not on main")
            continue
        if live:
            try:
                delete(name, sha, last)
            except Refused as refusal:
                kept += 1
                print(f"keep {name}: {refusal}")
                continue
            except (Failed, urllib.error.HTTPError, urllib.error.URLError) as error:
                failed += 1
                print(f"could not delete {name}: {getattr(error, 'code', error)}")
                continue
            print(f"deleted {name} {sha}: {how}")
        else:
            print(f"would delete {name} {sha}: {how}")
        deleted += 1
    verb = "deleted" if live else "would delete"
    print(f"{verb} {deleted}, held {held}, kept {kept}, failed {failed}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
