#!/usr/bin/env python3
"""Keep ordinary Bash build commands on the short local loop.

This checks shell words and the usual dev-shell and sabotage wrappers, not
the contents of scripts, interpreters or make recipes.

**What it reads as a command:** each simple command of the line, the command after
a keyword (`then`, `do`, `{`, `!`) or a wrapper (`env`, `time`, `nohup`, `nice`,
`timeout`, `xargs`, `sudo` and the others in WRAPPERS) with its options, the string
given to `eval`, `env -S` or `sh -c`, and every `$(...)` and backquote
substitution outside single quotes. A backslash and a newline join two lines, a
word is cut at whitespace only, and a comment is dropped.

**What it does not read, on purpose:** a script file or a make recipe, a
function or alias defined on the line, `coproc`, `trap`, `declare` and the other
builtins that store a command for later, here-document bodies as data (they are
judged as commands, so a body that mentions a refused command is refused), and
programs that take a command as an argument and are not in WRAPPERS (`find -exec`,
`git bisect run`, `watch`, `parallel`). A command run through them is not seen.
"""

import json
import os
import re
import shlex
import sys


MESSAGE = (
    "REFUSED: use make dev or make narrow CRATE=<crate> FILTER=<one substring>; "
    "keep the checkout and inherited CARGO_TARGET_DIR."
)
ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z_0-9]*\+?=")


def strip_redirections(command):
    """The command with every redirection outside quotes taken out.

    A redirection is no argument of the command it redirects: `make narrow ... > log
    2>&1` must read as `make narrow ...`. The lexer below cannot tell `2>&1` from
    three arguments, so this runs first. It drops the operator, the file
    descriptor before it, and the target word after it; `>&1` and `>&-` have no
    target word. A target ends at whitespace or a command separator, so
    `> log;cargo test` still leaves `cargo test` to be judged.
    """
    out = []
    quote = None
    ansi = False  # inside $'...', where a backslash escapes the next character
    backquote = False  # inside a backquote substitution
    brace = 0  # how deep inside ${...}
    i, n = 0, len(command)
    while i < n:
        c = command[i]
        if quote == "'":
            if ansi and c == "\\" and i + 1 < n:
                out.append(command[i : i + 2])
                i += 2
                continue
            out.append(c)
            if c == "'":
                quote = None
                ansi = False
            i += 1
        elif c == "\\":
            # Outside single quotes a backslash makes the next character literal, so
            # an escaped quote opens no span and an escaped `>` is no redirection. A
            # backslash and a newline join two lines and vanish, here, so that a
            # comment, which ends at its newline whatever precedes it, is not joined
            # to the line after it.
            if i + 1 >= n:
                raise ValueError("a backslash ends the command")
            if command[i + 1] != "\n":
                out.append(command[i : i + 2])
            i += 2
        elif quote:
            out.append(c)
            if c == quote:
                quote = None
            i += 1
        elif c in "'\"":
            ansi = c == "'" and bool(out) and out[-1] == "$"
            quote = c
            out.append(c)
            i += 1
        elif c == "`":
            backquote = not backquote
            out.append(c)
            i += 1
        elif c == "$" and command[i + 1 : i + 2] == "{":
            brace += 1
            out.append(c)
            i += 1
        elif c == "}" and brace:
            brace -= 1
            out.append(c)
            i += 1
        elif c == "#" and (not out or out[-1] in " \t\n;&|(") and not backquote and not brace:
            # A `#` that starts a word starts a comment, which the shell never runs
            # and which can hold a quote or a `>` that mean nothing. Inside a
            # backquote or a `${}` the text after it still holds the closing mark
            # and what follows, so it is kept and judged.
            while i < n and command[i] != "\n":
                i += 1
        elif c in "<>":
            start = len(out)
            while start > 0 and out[start - 1].isdigit():
                start -= 1
            if start == 0 or out[start - 1] in " \t\n;&|(":
                del out[start:]
            if out and out[-1] == "&" and (len(out) < 2 or out[-2] != "&"):
                out.pop()
            while i < n and command[i] in "<>":
                i += 1
            if i < n and command[i] == "&":
                k = i + 1
                while k < n and (command[k].isdigit() or command[k] == "-"):
                    k += 1
                if k > i + 1:
                    i = k
                    continue
            while i < n and command[i] in " \t":
                i += 1
            # **The target is read strictly, and a shape this does not model is
            # refused** (the caller maps the ValueError to a refusal): a backslash, a
            # `$`, a backtick or a second quote could hide a command in a word the
            # gate would then drop unread.
            if i < n and command[i] in "'\"":
                close = command.find(command[i], i + 1)
                if close < 0 or any(ch in command[i + 1 : close] for ch in "\\$`'\""):
                    raise ValueError("a redirection target this gate does not read")
                i = close + 1
                if i < n and command[i] not in " \t\n;&|()<>":
                    raise ValueError("a redirection target this gate does not read")
            else:
                while i < n and command[i] not in " \t\n;&|()<>":
                    if command[i] in "\\$`'\"":
                        raise ValueError("a redirection target this gate does not read")
                    i += 1
        else:
            out.append(c)
            i += 1
    return "".join(out)


def sets_target(word):
    return word.startswith(("CARGO_TARGET_DIR=", "CARGO_TARGET_DIR+="))


def positionals(words, takes_value):
    result = []
    index = 1
    while index < len(words):
        word = words[index]
        if word in takes_value:
            index += 2
        elif word.startswith("-"):
            index += 1
        else:
            result.append(word)
            index += 1
    return result


# A word that leads to the command after it when it starts a command.
KEYWORDS = {"if", "then", "else", "elif", "while", "until", "do", "!", "{"}
# A program that runs the command after it: the options that take a value, and how
# many plain words (a duration) come before that command.
WRAPPERS = {
    "env": ({"-u", "-C", "-S", "--unset", "--chdir", "--split-string"}, 0),
    "command": (set(), 0),
    "exec": ({"-a"}, 0),
    "time": (set(), 0),
    "nohup": (set(), 0),
    "nice": ({"-n", "--adjustment"}, 0),
    "setsid": (set(), 0),
    "stdbuf": ({"-i", "-o", "-e"}, 0),
    "ionice": ({"-c", "-n", "-p", "-t"}, 0),
    "timeout": ({"-k", "-s", "--kill-after", "--signal"}, 1),
    "sudo": ({"-u", "-g", "-h", "-p", "-C", "-D", "-R", "-T", "-U", "--user", "--group"}, 0),
    "xargs": (
        {"-n", "-I", "-P", "-d", "-L", "-s", "-E", "-a", "--max-args", "--replace",
         "--max-procs", "--delimiter", "--max-lines", "--max-chars", "--eof", "--arg-file"},
        0,
    ),
}
SHELLS = {"sh", "bash", "zsh", "dash", "ksh"}
CARGO_BUILDS = {"build", "test", "run", "check", "b", "t", "r", "c"}
CARGO_VALUE_OPTIONS = {"--color", "-C", "--config", "-Z", "--explain", "--manifest-path"}
DEPTH = 4


def after_wrapper(words, takes_value, plain):
    """The command a wrapper runs: past its options, and past the plain words it takes."""
    index = 1
    while index < len(words) and words[index].startswith("-") and words[index] != "-":
        index += 2 if words[index] in takes_value else 1
    return words[index + plain:]


def env_string(words):
    """The string `env -S` or `env --split-string` runs, with the words after it, or
    None when `env` is not given one."""
    index = 1
    while index < len(words) and words[index].startswith("-") and words[index] != "-":
        word = words[index]
        if word == "--split-string":
            return " ".join(words[index + 1 :])
        if word.startswith("--split-string="):
            return " ".join([word.split("=", 1)[1], *words[index + 1 :]])
        if not word.startswith("--"):
            # A cluster of short options, such as -iS: an option that takes a value
            # ends it, and for -S that value is the string, attached or the next word.
            for at, letter in enumerate(word[1:], start=1):
                if letter == "S":
                    attached = word[at + 1 :]
                    rest = words[index + 1 :]
                    return " ".join([attached, *rest] if attached else rest)
                if letter in "uC":
                    break
        index += 2 if word in WRAPPERS["env"][0] else 1
    return None


def blocked(words, depth=0):
    while words:
        if ASSIGNMENT.match(words[0]):
            if sets_target(words[0]):
                return True
            words = words[1:]
            continue
        if words[0] in KEYWORDS:
            words = words[1:]
            continue
        program = os.path.basename(words[0])
        if program == "env" and env_string(words) is not None:
            return judge(env_string(words), depth + 1)
        if program == "command" and any(word in ("-v", "-V") for word in words[1:2]):
            return False  # `command -v NAME` prints where NAME is and runs nothing
        if program in WRAPPERS:
            words = after_wrapper(words, *WRAPPERS[program])
            continue
        if program == "nix" and words[1:2] in (["develop"], ["shell"]):
            runs = [i for i, word in enumerate(words) if word in ("-c", "--command")]
            if runs:
                words = words[runs[0] + 1:]
                continue
        if program == "sabotage" and "--" in words:
            words = words[words.index("--") + 1:]
            continue
        break
    if not words:
        return False
    if program == "eval":
        return judge(" ".join(words[1:]), depth + 1)
    if program in SHELLS:
        # `sh -c STRING` and a cluster such as `bash -lc STRING` run STRING as a command.
        # The options end at the first word that is not one: after a script name, -c
        # is the script's own argument.
        # A `+` option (`+x`, `+o name`) turns an option off and is an option too.
        index = 1
        while index < len(words) and words[index].startswith(("-", "+")):
            word = words[index]
            if word.startswith("-") and not word.startswith("--") and "c" in word:
                return index + 1 < len(words) and judge(words[index + 1], depth + 1)
            index += 2 if word in ("-o", "-O", "+o", "+O", "--rcfile", "--init-file") else 1
        return False
    if program == "export":
        return any(sets_target(word) for word in words[1:])
    if program == "cargo":
        # The subcommand is the first word past cargo's own options and a +toolchain;
        # `t`, `b`, `r` and `c` are cargo's short names for test, build, run, check.
        # A later word is the subcommand's, such as the crate in `cargo add b`.
        index = 1
        while index < len(words) and words[index].startswith(("-", "+")):
            index += 2 if words[index] in CARGO_VALUE_OPTIONS else 1
        return index < len(words) and words[index] in CARGO_BUILDS
    if program == "git":
        args = positionals(words, {"-C", "-c", "--git-dir", "--work-tree"})
        return args[:1] == ["clone"] or args[:2] == ["worktree", "add"]
    if program != "make":
        return False
    # `-j N` and `--jobs N` take a number, which is no target.
    words = [
        word
        for at, word in enumerate(words)
        if not (word.isdigit() and words[at - 1] in ("-j", "--jobs"))
    ]
    args = positionals(words, {"-C", "--directory", "-f", "--file", "-I"})
    if any(sets_target(word) for word in args):
        return True
    targets = [word for word in args if not ASSIGNMENT.match(word)]
    if not targets or any(target not in {"dev", "narrow"} for target in targets):
        return True
    if "narrow" in targets:
        for name in ("CRATE", "FILTER"):
            values = [word.split("=", 1)[1] for word in args if word.startswith(name + "=")]
            if len(values) != 1 or not values[0] or len(values[0].split()) != 1:
                return True
    return False


def substitutions(command):
    """The text of every command substitution, `$(...)` or backquotes, that the shell
    would run: in double quotes too, and not inside single quotes or after a backslash.

    It also returns the command with each backquote span cut down to an empty pair, so
    that the lexer reads the span as one word: it holds the text of a substitution that
    is judged on its own, and a space inside it would split the word it is part of."""
    found = []
    masked = []
    quote = None
    i, n = 0, len(command)
    while i < n:
        c = command[i]
        start = i
        if quote == "'":
            quote = None if c == "'" else quote
            i += 1
        elif c == "\\":
            i += 2
        elif c == "`":
            close = i + 1
            while close < n and command[close] != "`":
                close += 2 if command[close] == "\\" else 1
            if close >= n:
                raise ValueError("a backquote is not closed")
            # Inside backquotes a backslash before a backquote, a dollar sign or a
            # backslash is taken off, so a nested substitution is written \`...\`.
            found.append(re.sub(r"\\([\\`$])", r"\1", command[i + 1 : close]))
            i = close + 1
            masked.append("``")
            continue
        elif c == "$" and command[i + 1 : i + 2] == "(":
            depth, j = 1, i + 2
            while j < n and depth:
                if command[j] == "\\":
                    j += 2
                    continue
                depth += (command[j] == "(") - (command[j] == ")")
                j += 1
            if depth:
                raise ValueError("a command substitution is not closed")
            found.append(command[i + 2 : j - 1])
            i = j
        else:
            if c == '"':
                quote = None if quote == '"' else '"'
            elif c == "'" and quote is None:
                quote = "'"
            i += 1
        masked.append(command[start:i])
    return found, "".join(masked)


def judge(command, depth=0):
    """Whether this command text runs something the gate refuses. A backslash and a
    newline join two lines, as the shell reads them; a substitution, a string given
    to `eval` and a string given to `sh -c` are read as commands in their turn, and
    nesting beyond a few levels is refused."""
    if depth > DEPTH:
        return True
    # Comments are dropped first: an apostrophe in one opens no quote, and the
    # substitutions after it still run.
    found, masked = substitutions(strip_redirections(command))
    if any(judge(inner, depth + 1) for inner in found):
        return True
    lexer = shlex.shlex(masked, posix=True, punctuation_chars=";&|()\n")
    lexer.whitespace = " \t\r"
    # A word ends at whitespace or a separator and nowhere else: without this the
    # lexer cuts `a::b`, `-I{}` and `user@host` into pieces, and the comments are
    # dropped before it, by strip_redirections.
    lexer.whitespace_split = True
    lexer.commenters = ""
    words = []
    commands = []
    for word in lexer:
        if all(char in ";&|()\n" for char in word):
            commands.append(words)
            words = []
        else:
            words.append(word)
    commands.append(words)
    return any(blocked(words, depth) for words in commands)


def main():
    try:
        command = json.load(sys.stdin)["tool_input"]["command"]
        if judge(command):
            print(MESSAGE, file=sys.stderr)
            return 2
    except (ValueError, KeyError, TypeError):
        print(MESSAGE, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
