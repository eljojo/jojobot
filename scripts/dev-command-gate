#!/usr/bin/env python3
"""Keep ordinary Bash build commands on the short local loop.

This checks shell words and the usual dev-shell and sabotage wrappers, not
the contents of scripts, interpreters or make recipes.
"""

import json
import os
import re
import shlex
import sys


MESSAGE = (
    "REFUSED: use make dev or make narrow CRATE=<crate> FILTER=<one substring>; "
    "keep the checkout and inherited CARGO_TARGET_DIR."
)
ASSIGNMENT = re.compile(r"[A-Za-z_][A-Za-z_0-9]*\+?=")


def strip_redirections(command):
    """The command with every redirection outside quotes taken out.

    A redirection is no argument of the command it redirects: `make narrow ... > log
    2>&1` must read as `make narrow ...`. The lexer below cannot tell `2>&1` from
    three arguments, so this runs first. It drops the operator, the file
    descriptor before it, and the target word after it; `>&1` and `>&-` have no
    target word. A target ends at whitespace or a command separator, so
    `> log;cargo test` still leaves `cargo test` to be judged.
    """
    out = []
    quote = None
    i, n = 0, len(command)
    while i < n:
        c = command[i]
        if quote == "'":
            out.append(c)
            if c == "'":
                quote = None
            i += 1
        elif c == "\\":
            # Outside single quotes a backslash makes the next character literal, so
            # an escaped quote opens no span and an escaped `>` is no redirection.
            if i + 1 >= n:
                raise ValueError("a backslash ends the command")
            out.append(command[i : i + 2])
            i += 2
        elif quote:
            out.append(c)
            if c == quote:
                quote = None
            i += 1
        elif c in "'\"":
            quote = c
            out.append(c)
            i += 1
        elif c in "<>":
            start = len(out)
            while start > 0 and out[start - 1].isdigit():
                start -= 1
            if start == 0 or out[start - 1] in " \t\n;&|(":
                del out[start:]
            if out and out[-1] == "&" and (len(out) < 2 or out[-2] != "&"):
                out.pop()
            while i < n and command[i] in "<>":
                i += 1
            if i < n and command[i] == "&":
                k = i + 1
                while k < n and (command[k].isdigit() or command[k] == "-"):
                    k += 1
                if k > i + 1:
                    i = k
                    continue
            while i < n and command[i] in " \t":
                i += 1
            # **The target is read strictly, and a shape this does not model is
            # refused** (the caller maps the ValueError to a refusal): a backslash, a
            # `$`, a backtick or a second quote could hide a command in a word the
            # gate would then drop unread.
            if i < n and command[i] in "'\"":
                close = command.find(command[i], i + 1)
                if close < 0 or any(ch in command[i + 1 : close] for ch in "\\$`'\""):
                    raise ValueError("a redirection target this gate does not read")
                i = close + 1
                if i < n and command[i] not in " \t\n;&|()<>":
                    raise ValueError("a redirection target this gate does not read")
            else:
                while i < n and command[i] not in " \t\n;&|()<>":
                    if command[i] in "\\$`'\"":
                        raise ValueError("a redirection target this gate does not read")
                    i += 1
        else:
            out.append(c)
            i += 1
    return "".join(out)


def sets_target(word):
    return word.startswith(("CARGO_TARGET_DIR=", "CARGO_TARGET_DIR+="))


def positionals(words, takes_value):
    result = []
    index = 1
    while index < len(words):
        word = words[index]
        if word in takes_value:
            index += 2
        elif word.startswith("-"):
            index += 1
        else:
            result.append(word)
            index += 1
    return result


# A word that leads to the command after it when it starts a command.
KEYWORDS = {"if", "then", "else", "elif", "while", "until", "do", "!", "{"}
# A program that runs the command after it: the options that take a value, and how
# many plain words (a duration) come before that command.
WRAPPERS = {
    "env": ({"-u", "-C", "-S", "--unset", "--chdir", "--split-string"}, 0),
    "command": (set(), 0),
    "exec": ({"-a"}, 0),
    "time": (set(), 0),
    "nohup": (set(), 0),
    "nice": ({"-n", "--adjustment"}, 0),
    "setsid": (set(), 0),
    "stdbuf": ({"-i", "-o", "-e"}, 0),
    "ionice": ({"-c", "-n", "-p", "-t"}, 0),
    "timeout": ({"-k", "-s", "--kill-after", "--signal"}, 1),
    "sudo": ({"-u", "-g", "-h", "-p", "-C", "-D", "-R", "-T", "-U", "--user", "--group"}, 0),
    "xargs": (
        {"-n", "-I", "-P", "-d", "-L", "-s", "-E", "-a", "--max-args", "--replace",
         "--max-procs", "--delimiter", "--max-lines", "--max-chars", "--eof", "--arg-file"},
        0,
    ),
}
SHELLS = {"sh", "bash", "zsh", "dash", "ksh"}
DEPTH = 4


def after_wrapper(words, takes_value, plain):
    """The command a wrapper runs: past its options, and past the plain words it takes."""
    index = 1
    while index < len(words) and words[index].startswith("-") and words[index] != "-":
        index += 2 if words[index] in takes_value else 1
    return words[index + plain:]


def blocked(words, depth=0):
    while words:
        if ASSIGNMENT.match(words[0]):
            if sets_target(words[0]):
                return True
            words = words[1:]
            continue
        if words[0] in KEYWORDS:
            words = words[1:]
            continue
        program = os.path.basename(words[0])
        if program in WRAPPERS:
            words = after_wrapper(words, *WRAPPERS[program])
            continue
        if program == "nix" and words[1:2] == ["develop"] and "-c" in words:
            words = words[words.index("-c") + 1:]
            continue
        if program == "sabotage" and "--" in words:
            words = words[words.index("--") + 1:]
            continue
        break
    if not words:
        return False
    if program == "eval":
        return judge(" ".join(words[1:]), depth + 1)
    if program in SHELLS:
        # `sh -c STRING` and a cluster such as `bash -lc STRING` run STRING as a command.
        for index, word in enumerate(words[1:], start=1):
            if word.startswith("-") and not word.startswith("--") and "c" in word:
                return index + 1 < len(words) and judge(words[index + 1], depth + 1)
        return False
    if program == "export":
        return any(sets_target(word) for word in words[1:])
    if program == "cargo":
        return bool(set(words[1:]) & {"build", "test", "run", "check"})
    if program == "git":
        args = positionals(words, {"-C", "-c", "--git-dir", "--work-tree"})
        return args[:1] == ["clone"] or args[:2] == ["worktree", "add"]
    if program != "make":
        return False
    args = positionals(words, {"-C", "--directory", "-f", "--file", "-I"})
    if any(sets_target(word) for word in args):
        return True
    targets = [word for word in args if not ASSIGNMENT.match(word)]
    if not targets or any(target not in {"dev", "narrow"} for target in targets):
        return True
    if "narrow" in targets:
        for name in ("CRATE", "FILTER"):
            values = [word.split("=", 1)[1] for word in args if word.startswith(name + "=")]
            if len(values) != 1 or not values[0] or len(values[0].split()) != 1:
                return True
    return False


def substitutions(command):
    """The text of every command substitution, `$(...)` or backquotes, that the shell
    would run: in double quotes too, and not inside single quotes or after a backslash."""
    found = []
    quote = None
    i, n = 0, len(command)
    while i < n:
        c = command[i]
        if quote == "'":
            quote = None if c == "'" else quote
            i += 1
        elif c == "\\":
            i += 2
        elif c == "`":
            close = i + 1
            while close < n and command[close] != "`":
                close += 2 if command[close] == "\\" else 1
            if close >= n:
                raise ValueError("a backquote is not closed")
            found.append(command[i + 1 : close])
            i = close + 1
        elif c == "$" and command[i + 1 : i + 2] == "(":
            depth, j = 1, i + 2
            while j < n and depth:
                if command[j] == "\\":
                    j += 2
                    continue
                depth += (command[j] == "(") - (command[j] == ")")
                j += 1
            if depth:
                raise ValueError("a command substitution is not closed")
            found.append(command[i + 2 : j - 1])
            i = j
        else:
            if c == '"':
                quote = None if quote == '"' else '"'
            elif c == "'" and quote is None:
                quote = "'"
            i += 1
    return found


def judge(command, depth=0):
    """Whether this command text runs something the gate refuses. A backslash and a
    newline join two lines, as the shell reads them; a substitution, a string given
    to `eval` and a string given to `sh -c` are read as commands in their turn, and
    nesting beyond a few levels is refused."""
    if depth > DEPTH:
        return True
    command = command.replace("\\\n", "")
    if any(judge(inner, depth + 1) for inner in substitutions(command)):
        return True
    lexer = shlex.shlex(strip_redirections(command), posix=True, punctuation_chars=";&|()\n")
    lexer.whitespace = " \t\r"
    words = []
    commands = []
    for word in lexer:
        if all(char in ";&|()\n" for char in word):
            commands.append(words)
            words = []
        else:
            words.append(word)
    commands.append(words)
    return any(blocked(words, depth) for words in commands)


def main():
    try:
        command = json.load(sys.stdin)["tool_input"]["command"]
        if judge(command):
            print(MESSAGE, file=sys.stderr)
            return 2
    except (ValueError, KeyError, TypeError):
        print(MESSAGE, file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    sys.exit(main())
