#!/usr/bin/env python3
"""**Wait for the run of a commit on Forgejo, and print only its verdict.**

    scripts/wait-run <branch | commit> [--timeout SECONDS] [--interval SECONDS]

With --code-proof, the target must be a full SHA. The tool reads once, without
polling or logs, and exits 0 only for a successful pull-request/full-dispatch
run with build, check, rooms and year green. Only the two release-only jobs
may be skipped. This licenses the docs-only base; it is not release readiness.

A line that pushed a branch starts this as one background command and is woken
when it returns. It finds the run of the commit, polls until the run ends, and
prints the run's number, its ref and its commit, then, for each job of the run,
its name, its status and the bar's verdict block from its log: the verdict, each
phase and the names that FAILED, and nothing else of the log.

  A JOB WHOSE LOG HOLDS NO VERDICT BLOCK and carries a line the runner wrote when
  it lost the job ("RUN signal: terminated", "context canceled", "failed to stat
  working directory", or "No such file or directory (os error 2)") prints
  RUNNER DIED and that line, the first of them in the log. A job with neither a
  block nor such a line says it holds no block. A block wins over a runner line:
  a job that reached its verdict did not die.

  A BRANCH is resolved to the head the forge holds for it, and the run is the one
  on that ref. A COMMIT is a full hash or the first seven or more characters of
  one; the run is the newest run of that commit, and any other run of the same
  commit (another branch pushed the same hash) is named, not used.

With --workflow, it reads that workflow's run even when a newer targeted run
holds the same SHA. It matches on the commit and the ref the forge reports. It never reads a number
out of a run's URL: the URL carries the run's index in the repository, which is
not the run's number.

Exit code: 0 the run succeeded (every job green), 1 it failed and a job's block
says RED, or it failed and nothing else is known, 2 it was cancelled or skipped,
3 no run ended before the timeout, 4 the branch or commit names nothing, 5 it
failed, no job is RED and at least one job died on the runner: that is a run to
send again, not a test to fix.

It reads and nothing else: the actions API of the repository answers a read with
no credential, so none is asked for, read or stored. WAIT_RUN_API names the
repository's API root, for example http://forge.invalid:3000/api/v1/repos/homer/jojobot.
It has no default host: this repository names no forge. On a Forgejo Actions runner,
with the variable unset, the root is built from the runner's own GITHUB_API_URL and
GITHUB_REPOSITORY. With neither, the tool exits 4 before it asks anything.
"""
import argparse
import json
import os
import re
import sys
import time
import urllib.error
import urllib.parse
import urllib.request


def api_root():
    """The repository's API root: WAIT_RUN_API, else the runner's own context, else none.
    The context is the API URL and the repository that Forgejo Actions sets, and counts
    only on a runner."""
    named = os.environ.get("WAIT_RUN_API")
    if named:
        return named
    if os.environ.get("GITHUB_ACTIONS") == "true":
        api = os.environ.get("GITHUB_API_URL")
        repository = os.environ.get("GITHUB_REPOSITORY")
        if api and repository:
            return f"{api.rstrip('/')}/repos/{repository}"
    return ""


API = api_root()
# A run that has reached one of these is over; every other status is still going.
FINAL = {"success": 0, "failure": 1, "cancelled": 2, "skipped": 2}
PAGE = 50
PAGES = 40


class Gone(Exception):
    """The forge said 404."""


def fetch(path, params=None):
    url = API + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    try:
        with urllib.request.urlopen(url, timeout=30) as answer:
            return answer.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as err:
        if err.code == 404:
            raise Gone(url) from err
        raise


def runs_of(**params):
    """The runs the forge lists for these filters, newest first."""
    return json.loads(fetch("/actions/runs", {"limit": PAGE, **params}))["workflow_runs"]


def code_proof(sha):
    """Read once: only a completed code predecessor licenses the docs fast path."""
    required = {"build", "check", "rooms", "year"}
    optional = {"nix-build", "flake-check"}
    if API and re.fullmatch(r"[0-9a-f]{40}", sha):
        try:
            for run in sorted(runs_of(head_sha=sha), key=lambda r: r["id"], reverse=True):
                if not (run.get("commit_sha") == sha
                        and run.get("workflow_id") == "pull-request.yml"
                        and (run.get("event") or run.get("trigger_event"))
                        in {"pull_request", "workflow_dispatch"}
                        and run.get("status") == "success"):
                    continue
                jobs = json.loads(fetch(f"/actions/runs/{run['id']}/jobs"))
                green = {j["name"] for j in jobs if j["status"] == "success"}
                if required <= green and all(
                    j["status"] == "success"
                    or (j["name"] in optional and j["status"] == "skipped")
                    for j in jobs
                ):
                    print(f"code proof: run #{run['id']} {run['html_url']} on {sha}")
                    return 0
        except Exception as err:
            print(f"code proof: forge read failed ({err})", file=sys.stderr)
    print(f"code proof: no completed code proof of {sha}", file=sys.stderr)
    return 1


def stop(code, words):
    print(words, file=sys.stderr)
    sys.exit(code)


def resolve(target):
    """The full commit to wait for, and the ref it has to be run on, if any."""
    if re.fullmatch(r"[0-9a-f]{40}", target):
        return target, None
    if re.fullmatch(r"[0-9a-f]{7,39}", target):
        found = set()
        for page in range(1, PAGES + 1):
            listed = runs_of(page=page)
            if not listed:
                break
            found |= {r["commit_sha"] for r in listed if r["commit_sha"].startswith(target)}
        if len(found) > 1:
            stop(4, f"{target} is the start of more than one commit: {sorted(found)}")
        if found:
            return found.pop(), None
        # No run has been seen for it yet; the checkout may know it whole.
        import subprocess

        whole = subprocess.run(
            ["git", "rev-parse", "--verify", "--quiet", target + "^{commit}"],
            capture_output=True,
            text=True,
        )
        if whole.returncode == 0:
            return whole.stdout.strip(), None
        stop(4, f"no run and no commit of this checkout starts with {target}")
    try:
        head = json.loads(fetch("/branches/" + urllib.parse.quote(target, safe="")))
    except Gone:
        stop(4, f"the forge holds no branch {target}: push it first")
    return head["commit"]["id"], target


def find(sha, ref, workflow=None):
    """The run to read and the other runs of the same commit, or None."""
    held = [r for r in runs_of(head_sha=sha) if r["commit_sha"] == sha]
    held.sort(key=lambda r: r["id"], reverse=True)
    mine = [
        r for r in held
        if (ref is None or r["prettyref"] == ref)
        and (workflow is None or r.get("workflow_id") == workflow)
    ]
    if not mine:
        return None
    return mine[0], [r for r in held if r is not mine[0]]


# What the runner writes when it loses a job. A log with a verdict block is not read for these.
RUNNER_LOST = (
    "RUN signal: terminated",
    "context canceled",
    "failed to stat working directory",
    "No such file or directory (os error 2)",
)


def classify(text):
    """**How one job's log ended, in one place.** Returns ("block", lines) when the log holds
    the bar's verdict block, from the `verdict:` line to the `log:` line that ends it, both the
    bar's own lines and without timestamps; else ("died", line) with the first line that
    names a runner loss; else ("none", None)."""
    lines = [re.sub(r"^\d{4}-\d\d-\d\dT[\d:.]+Z ", "", l) for l in text.splitlines()]
    start = next((i for i, l in enumerate(lines) if l.startswith("verdict:")), None)
    end = next((i for i, l in enumerate(lines) if l.startswith("log:")), None)
    if start is not None and end is not None and end >= start:
        return "block", lines[start : end + 1]
    died = next((l for l in lines if any(lost in l for lost in RUNNER_LOST)), None)
    if died is not None:
        return "died", died.strip()
    return "none", None


def report(run):
    """Print every job of the run with its status and how its log ended. Returns whether any
    job is red and whether any job died on the runner."""
    jobs = json.loads(fetch(f"/actions/runs/{run['id']}/jobs"))
    if not jobs:
        print("no jobs in this run")
    red = died = False
    for job in jobs:
        print(f"job {job['name']}  {job['status']}")
        kind, found = classify(fetch(f"/actions/jobs/{job['id']}/logs"))
        if kind == "block":
            print("\n".join(found))
            red = red or found[0] != "verdict: GREEN"
        elif kind == "died":
            print(f"RUNNER DIED: {found}")
            died = True
        else:
            print(f"no verdict block in the log of the {job['name']} job")
        print()
    return red, died


class Asking(argparse.ArgumentParser):
    """A usage error exits 4, like any target that names nothing: argparse's own 2 is the
    exit code of a cancelled run."""

    def error(self, message):
        stop(4, f"{self.prog}: {message}")


def main():
    ask = Asking(description="Wait for the Forgejo run of a commit.")
    ask.add_argument("target", help="a branch, or a commit (full, or seven or more characters)")
    ask.add_argument("--workflow", help="workflow file, e.g. pull-request.yml or targeted.yml")
    ask.add_argument("--code-proof", action="store_true", help="read a full-SHA docs-base proof once; never wait (exit 0 or 1)")
    # A branch job may run 120 minutes (timeout-minutes in branch.yml) after a queue.
    ask.add_argument("--timeout", type=float, default=9000, help="seconds to wait in all (default %(default)s)")
    ask.add_argument("--interval", type=float, default=15, help="seconds between asks")
    args = ask.parse_args()
    if args.code_proof:
        sys.exit(code_proof(args.target))
    if not API:
        stop(4, "WAIT_RUN_API is not set: set it to the repository's API root on your Forgejo")

    deadline = time.monotonic() + args.timeout
    sha = ref = None
    seen = None
    while True:
        try:
            if sha is None:
                sha, ref = resolve(args.target)
            found = find(sha, ref, args.workflow)
        except Gone as err:
            stop(4, f"the forge has nothing at {err}: is WAIT_RUN_API the repository's API root?")
        except (urllib.error.URLError, TimeoutError, OSError) as err:
            found = None
            print(f"the forge did not answer ({err}); asking again", file=sys.stderr)
        if found:
            run, others = found
            if seen != (run["id"], run["status"]):
                seen = (run["id"], run["status"])
                print(f"run #{run['id']} is {run['status']}", file=sys.stderr)
            if run["status"] in FINAL:
                break
        if time.monotonic() >= deadline:
            what = sha or args.target
            stop(3, f"no run of {what}" + (f" on {ref}" if ref else "") + " ended in time")
        time.sleep(args.interval)

    print(f"run #{run['id']}  ref {run['prettyref']}  sha {run['commit_sha']}  {run['status']}")
    print(run["html_url"])
    if others:
        print(
            "also on this commit: "
            + ", ".join(f"#{r['id']} {r['prettyref']} ({r['status']})" for r in others)
        )
    print()
    red, died = report(run)
    code = FINAL[run["status"]]
    if code == 1 and died and not red:
        code = 5
    sys.exit(code)


if __name__ == "__main__":
    main()
