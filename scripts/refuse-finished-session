#!/usr/bin/env python3
"""Refuse a later prompt, while leaving tools in the wrapping turn alone."""

import json
import os
from pathlib import Path
import sys


def main():
    agent = os.environ.get("PASEO_AGENT_ID")
    if not agent:
        return 0
    state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    mark = state / "jojobot/finished" / agent
    if not mark.exists():
        return 0
    kept = json.loads(mark.read_text())
    print(
        f"This session is finished: run {kept['run']} wrapped at {kept['wrapped_at']}. "
        "End the turn and do nothing. Whoever needs the role must start a new "
        "agent from document:build-runtime.",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    sys.exit(main())
