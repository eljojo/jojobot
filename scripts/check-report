#!/usr/bin/env python3
"""**Check the facts in a line report's header, before the prose is read.**

    scripts/check-report < report.txt

The report comes on stdin. Its top carries COMMIT:, BRANCH:, BASE:, RUN:, OWNER:,
RETIRES:, FALSIFY: and SELF-REVIEW: lines, one value each; the header ends at the
first line that is neither blank nor one of those keys, so the header is the top
of the report and any preamble goes below it. The tool prints one line
per key, `pass` or `FAIL` and the reason, and exits 0 only when all pass.

  OWNER, FALSIFY and SELF-REVIEW pass when they hold a value. RETIRES passes when
  it names what it retires, or says `none` and then the reason.
  NET passes when the report holds the bar's net table (`bar size --net`): its
  heading line and its total line, anywhere in the text.

  COMMIT is the head the forge holds for BRANCH.
  BASE is an ancestor of COMMIT in the current checkout (git merge-base
  --is-ancestor). It fetches nothing: a BASE the checkout does not hold fails.
  RUN is a run of COMMIT on BRANCH, and it succeeded.
  BRANCH passes when the forge holds it.

A key the header lacks is a FAIL that names it. A check that needs a missing key
says which one.

**Review mode.** A review report carries a header line `REVIEW: BASE..H` and, below
the header, a block opened by a line `COVERAGE:` with one line for each file:

    <path> read-by <reader>
    <path> UNREAD <reason>

The block ends at its first blank line. The tool lists the range's own files with
`git diff --name-only BASE..H` in the current checkout (it fetches nothing) and
fails, naming each path, when a changed file has no line, a line says UNREAD, a
line names no reader, a line names a file outside the range, or a line is neither
form. A report with a REVIEW line and no COVERAGE block fails. In review mode the
four keys above are checked when the header holds them and are not demanded: a
review is identified by its range. A report with no REVIEW line is checked as before.

The forge is read the way scripts/wait-run reads it, with its lookup and its
WAIT_RUN_API; no credential is asked for. With no API root the tool exits 4.

Exit code: 0 all checks pass, 1 one or more failed, 4 no API root (a review report
that holds none of the four keys needs no forge, so it needs no API root).
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.parse

KEYS = ("COMMIT", "BRANCH", "BASE", "RUN", "OWNER", "RETIRES", "FALSIFY", "SELF-REVIEW", "NET")
NAMED = ("OWNER", "RETIRES", "FALSIFY", "SELF-REVIEW")
HEADER_KEYS = KEYS + ("REVIEW",)


def wait_run():
    """scripts/wait-run as a module, so the lookup is the one it uses."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "wait-run")
    loader = importlib.machinery.SourceFileLoader("wait_run", path)
    spec = importlib.util.spec_from_loader("wait_run", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def header_of(text):
    """The header's keys and values: the first value of each key, from the top, up to
    the first line that is neither blank nor a key."""
    found = {}
    for line in text.splitlines():
        if not line.strip():
            continue
        match = re.fullmatch(r"(COMMIT|BRANCH|BASE|RUN|OWNER|RETIRES|FALSIFY|SELF-REVIEW|REVIEW):\s*(\S.*?)\s*", line)
        if not match:
            break
        found.setdefault(match.group(1), match.group(2))
    return found


def merge_base_says(base, commit):
    """Whether BASE is an ancestor of COMMIT in this checkout, and the reason if not."""
    ran = subprocess.run(
        ["git", "merge-base", "--is-ancestor", base + "^{commit}", commit + "^{commit}"],
        capture_output=True,
        text=True,
    )
    if ran.returncode == 0:
        return True, f"{base} is an ancestor of {commit}"
    if ran.returncode == 1:
        return False, f"{base} is not an ancestor of {commit}"
    return False, f"this checkout cannot compare {base} and {commit}: {ran.stderr.strip()}"


def resolve(rev):
    """The whole commit `rev` names in this checkout, or None."""
    ran = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", rev + "^{commit}"],
        capture_output=True,
        text=True,
    )
    return ran.stdout.strip() if ran.returncode == 0 else None


def coverage_block(text):
    """The lines of the COVERAGE block below the header: from the line after the
    first `COVERAGE:` line to the first blank line. None when there is none."""
    lines = text.splitlines()
    for at, line in enumerate(lines):
        if line.strip() == "COVERAGE:":
            block = []
            for entry in lines[at + 1 :]:
                if not entry.strip():
                    break
                block.append(entry.strip())
            return block
    return None


def review_says(spec, text):
    """The review checks: every line they print, and whether all passed."""
    printed = []
    ok = True

    def fail(words):
        nonlocal ok
        ok = False
        printed.append(f"FAIL {words}")

    match = re.fullmatch(r"(\S+)\.\.(\S+)", spec)
    if not match:
        fail(f"REVIEW: {spec} is not BASE..H")
        return printed, ok
    base, head = match.groups()
    full_base, full_head = resolve(base), resolve(head)
    for name, full in ((base, full_base), (head, full_head)):
        if full is None:
            fail(f"REVIEW: this checkout holds no commit {name}")
    if full_base is None or full_head is None:
        return printed, ok
    ran = subprocess.run(
        ["git", "diff", "--name-only", "-z", f"{full_base}..{full_head}"],
        capture_output=True,
        text=True,
    )
    if ran.returncode != 0:
        fail(f"REVIEW: this checkout cannot list the range: {ran.stderr.strip()}")
        return printed, ok
    changed = [path for path in ran.stdout.split("\0") if path]
    printed.append(f"pass REVIEW: {spec} changes {len(changed)} files")

    block = coverage_block(text)
    if block is None:
        fail("COVERAGE: the report has no COVERAGE: block")
        return printed, ok
    claimed = {}
    for line in block:
        entry = re.fullmatch(r"(.+?) (read-by|UNREAD)(?: (.*))?", line)
        if not entry:
            fail(f"COVERAGE: a line that is neither `<path> read-by <reader>` nor `<path> UNREAD <reason>`: {line}")
            continue
        path, kind, rest = entry.group(1), entry.group(2), (entry.group(3) or "").strip()
        if path not in changed:
            fail(f"COVERAGE: {path} is not a file of {spec}")
        elif kind == "UNREAD":
            fail(f"COVERAGE: {path} is UNREAD" + (f": {rest}" if rest else ""))
        elif not rest:
            fail(f"COVERAGE: {path} names no reader")
        elif claimed.get(path) is None:
            claimed[path] = rest
    for path in changed:
        if path not in claimed and not any(
            line.startswith(path + " ") for line in block
        ):
            fail(f"COVERAGE: {path} changed in {spec} and has no line")
    read = sum(1 for path in changed if path in claimed)
    if ok:
        printed.append(f"pass COVERAGE: all {read} changed files are marked read")
    return printed, ok


def json_head(wr, branch):
    """The commit the forge holds as the head of `branch`."""
    return json.loads(wr.fetch("/branches/" + urllib.parse.quote(branch, safe="")))["commit"]["id"]


def main():
    wr = wait_run()
    text = sys.stdin.read()
    header = header_of(text)
    review = header.get("REVIEW")
    if not wr.API and not (review and not any(key in header for key in KEYS)):
        print("WAIT_RUN_API is not set: set it to the repository's API root", file=sys.stderr)
        sys.exit(4)
    commit, branch = header.get("COMMIT"), header.get("BRANCH")
    results = {}

    head = None
    if branch is not None:
        try:
            head = json_head(wr, branch)
            results["BRANCH"] = (True, f"the forge holds {branch}")
        except wr.Gone:
            results["BRANCH"] = (False, f"the forge holds no branch {branch}")
        except (urllib.error.URLError, TimeoutError, OSError) as err:
            results["BRANCH"] = (False, f"the forge did not answer: {err}")

    full = None
    if commit is not None and re.fullmatch(r"[0-9a-f]{40}", commit):
        full = commit
    elif commit is not None and head and len(commit) >= 7 and head.startswith(commit):
        full = head
    if commit is not None and branch is not None and "BRANCH" in results and results["BRANCH"][0]:
        if head == commit or (len(commit) >= 7 and head.startswith(commit)):
            results["COMMIT"] = (True, f"{commit} is the head of {branch}")
        else:
            results["COMMIT"] = (False, f"{commit} is not the head of {branch}, which is {head}")

    if "BASE" in header and commit is not None:
        results["BASE"] = merge_base_says(header["BASE"], commit)

    if "RUN" in header and commit is not None and branch is not None:
        if full is None:
            results["RUN"] = (False, f"{commit} is not a whole commit the forge head can complete")
        elif not re.fullmatch(r"#?\d+", header["RUN"]):
            results["RUN"] = (False, f"{header['RUN']} is not a run number")
        else:
            number = int(header["RUN"].lstrip("#"))
            try:
                runs = wr.runs_of(head_sha=full)
            except wr.Gone:
                runs = None
                results["RUN"] = (False, "the forge has no run list at the API root")
            except (urllib.error.URLError, TimeoutError, OSError) as err:
                runs = None
                results["RUN"] = (False, f"the forge did not answer: {err}")
            if runs is not None:
                mine = [r for r in runs if r["id"] == number and r["commit_sha"] == full]
                if not mine:
                    results["RUN"] = (False, f"{number} is not a run of {full}")
                elif mine[0]["prettyref"] != branch:
                    results["RUN"] = (False, f"run {number} is on {mine[0]['prettyref']}, not {branch}")
                elif mine[0]["status"] != "success":
                    results["RUN"] = (False, f"run {number} is {mine[0]['status']}")
                else:
                    results["RUN"] = (True, f"run {number} of {full} on {branch} succeeded")

    for key in NAMED:
        if key in header:
            results[key] = (True, "named")
    if re.fullmatch(r"(?i)none\W*", header.get("RETIRES", "")):
        results["RETIRES"] = (False, "none needs its reason")
    if re.search(r"^net lines by area since \S+", text, re.M) and re.search(r"total; source plus tests", text):
        header["NET"] = "table"
        results["NET"] = (True, "the report holds the net table")

    wanting = {
        "COMMIT": ("BRANCH",),
        "BASE": ("COMMIT",),
        "RUN": ("COMMIT", "BRANCH"),
    }
    ok = True
    for key in KEYS:
        if key not in header:
            if review:
                continue
            print(f"FAIL {key}: " + ("no net table in the report" if key == "NET" else "missing from the header"))
            ok = False
        elif key in results:
            good, words = results[key]
            print(f"{'pass' if good else 'FAIL'} {key}: {words}")
            ok = ok and good
        else:
            lacking = [o for o in wanting.get(key, ()) if o not in header]
            print(f"FAIL {key}: cannot be checked, {', '.join(lacking) or 'a check it needs'} missing")
            ok = False
    if review:
        printed, review_ok = review_says(review, text)
        for line in printed:
            print(line)
        ok = ok and review_ok
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
