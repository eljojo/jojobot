#!/usr/bin/env python3
"""**Check the facts in a line report's header, before the prose is read.**

    scripts/check-report [--card FILE] < report.txt

The report comes on stdin. Its top carries COMMIT:, BRANCH:, BASE:, RUN:, OWNER:,
RETIRES:, FALSIFY: and SELF-REVIEW: lines, one value each; the header ends at the
first line that is neither blank nor one of those keys, so the header is the top
of the report and any preamble goes below it. The tool prints one line
per key, `pass` or `FAIL` and the reason, and exits 0 only when all pass.

  OWNER, FALSIFY and SELF-REVIEW pass when they hold a value. RETIRES passes when
  it names what it retires, or says `none` and then the reason.
  NET passes when the report holds the bar's net table (`bar size --net`): its
  heading line and its total line, anywhere in the text.

  COMMIT is the head the forge holds for BRANCH.
  BASE is an ancestor of COMMIT in the current checkout (git merge-base
  --is-ancestor). It fetches nothing: a BASE the checkout does not hold fails.
  RUN is the number of a run of COMMIT on BRANCH, and it succeeded. The number is
  the run's index in the repository, the one scripts/wait-run prints first; the
  forge id in brackets beside it fails, naming the number to write.
  BRANCH passes when the forge holds it.

A key the header lacks is a FAIL that names it. A check that needs a missing key
says which one.

**The card's own keys.** `--card FILE` names a JSON file holding the card's fields as
`recall` returns them under `fields` for one item, made with `recall` subject
work:q-CARD keys [owner_module, retires, falsify, review, self_review, done_line]. OWNER,
RETIRES, FALSIFY and SELF-REVIEW that the header lacks are taken from `owner_module`,
`retires`, `falsify` and `self_review` (then `review`, unless it is `none`), and are
checked exactly as a header value is. A header value wins over the card's. The card
adds nothing to a review report. The file is read from disk; no credential or
network is used for it.

**Review mode.** A review report carries a header line `REVIEW: BASE..H` and, below
the header, a block opened by a line `COVERAGE:` with one line for each file:

    <path> read-by <reader>
    <path> UNREAD <reason>

The block ends at its first blank line. The tool lists the range's own files with
`git diff --name-only BASE..H` in the current checkout (it fetches nothing) and
fails, naming each path, when a changed file has no line, a line says UNREAD, a
line names no reader, a line names a file outside the range, or a line is neither
form. A report with a REVIEW line and no COVERAGE block fails.

**A scoped lens.** A lens whose scope is part of the range opens its COVERAGE block
with a line `INVENTORY: <git command>`, one or more, each a read-only listing
(`git diff`, `git ls-files` or `git ls-tree`, run without a shell). The files they
print are the lens's scope: each must be a file of the range and each must be marked
read, and the range's other files are not demanded. An inventory that is not such a
listing, fails, lists nothing or names a file outside the range fails, naming it.
With no INVENTORY line the whole range is owed, as above. In review mode the
four keys above are checked when the header holds them and are not demanded: a
review is identified by its range. A report with no REVIEW line is checked as before.

**The card's done line.** With `--card`, the clause is read from `done_line` when
that key holds a value, which only the PM writes, and from `falsify` otherwise, which a
line's report overwrites. A card whose `done_line` or `falsify` holds a clause
`done when it prints [under|over|at most|at least|exactly] N` has a done line. The
command is the text before the first ` prints `. It runs through `bash -o pipefail -c` in the
current checkout, so `HEAD` is the head being landed, and its output must be one
whole number that meets the comparison. DONE fails, naming the number, when it does
not. DONE also fails as unrunnable when the clause names no comparison and number,
or the command fails or prints no number. It runs only where HEAD is the header's
COMMIT, and DONE fails naming both otherwise. A failure with exit 1 and nothing on
stderr is a grep that matched nothing, so a count of 0 stands; any other failure
is unrunnable. Words after the number are not checked.
The clause is required: a card with no `done when` clause fails DONE as
unrunnable, so it cannot be carried. A review report runs no DONE.

The forge is read the way scripts/wait-run reads it, with its lookup and its
WAIT_RUN_API; no credential is asked for. With no API root the tool exits 4.

Exit code: 0 all checks pass, 1 one or more failed, 4 no API root (a review report
that holds none of the four keys needs no forge, so it needs no API root).
"""
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
import urllib.error
import urllib.parse

KEYS = ("COMMIT", "BRANCH", "BASE", "RUN", "OWNER", "RETIRES", "FALSIFY", "SELF-REVIEW", "NET")
NAMED = ("OWNER", "RETIRES", "FALSIFY", "SELF-REVIEW")
HEADER_KEYS = KEYS + ("REVIEW",)


def wait_run():
    """scripts/wait-run as a module, so the lookup is the one it uses."""
    path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "wait-run")
    loader = importlib.machinery.SourceFileLoader("wait_run", path)
    spec = importlib.util.spec_from_loader("wait_run", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def header_of(text):
    """The header's keys and values: the first value of each key, from the top, up to
    the first line that is neither blank nor a key."""
    found = {}
    for line in text.splitlines():
        if not line.strip():
            continue
        match = re.fullmatch(r"(COMMIT|BRANCH|BASE|RUN|OWNER|RETIRES|FALSIFY|SELF-REVIEW|REVIEW):\s*(\S.*?)\s*", line)
        if not match:
            break
        found.setdefault(match.group(1), match.group(2))
    return found


LOCATORS = (
    ("sed -n", re.compile(r"\bsed\s+(-\S*n\S*)\s+['\"]?\d+(,\d+)?p")),
    ("grep -c", re.compile(r"\bgrep\s+(-\w*c\w*|--count)\b")),
    ("wc -l", re.compile(r"\bwc\s+-l\b")),
    ("head", re.compile(r"\bhead\s+-(n\s*)?\d+\b")),
    ("tail", re.compile(r"\btail\s+-(n\s*)?\d+\b")),
    ("file:LINE", re.compile(r"\S+\.\w+:\d+\b")),
)
NAME_GREP = re.compile(r"\bgrep\b(?!\s+(-\w*c\w*|--count)\b)")


def locator_shape(falsify):
    """The shape of a FALSIFY whose only evidence is a line window or a count, or
    None. A FALSIFY that also carries a grep or git grep for a name is accepted."""
    if NAME_GREP.search(falsify):
        return None
    for shape, pattern in LOCATORS:
        if pattern.search(falsify):
            return shape
    return None


# The header key each card field fills. SELF-REVIEW reads `self_review`, then `review`.
CARD_FIELDS = (
    ("OWNER", ("owner_module",)),
    ("RETIRES", ("retires",)),
    ("FALSIFY", ("falsify",)),
    ("SELF-REVIEW", ("self_review", "review")),
)


def card_value(card, fields):
    """The first card field of `fields` that holds a value. A `review` of none is the
    card's reset state, so it holds no review."""
    for field in fields:
        value = card.get(field)
        if not isinstance(value, str) or not value.strip():
            continue
        if field == "review" and re.fullmatch(r"(?i)none\W*", value.strip()):
            continue
        return value.strip()
    return None


def with_card(header, card):
    """The header, with each of OWNER, RETIRES, FALSIFY and SELF-REVIEW it lacks taken
    from the card. A value the header holds wins, even a bad one."""
    filled = dict(header)
    for key, fields in CARD_FIELDS:
        if key not in filled:
            value = card_value(card, fields)
            if value is not None:
                filled[key] = value
    return filled


DONE_CLAUSE = re.compile(r"\bdone when\b(.*)", re.S)
DONE_PRINTS = re.compile(r"it prints (?:(under|over|at most|at least|exactly) )?(\d+)\b")
DONE_COMPARES = {
    "under": lambda got, want: got < want,
    "over": lambda got, want: got > want,
    "at most": lambda got, want: got <= want,
    "at least": lambda got, want: got >= want,
    "exactly": lambda got, want: got == want,
    None: lambda got, want: got == want,
}


def done_says(falsify, commit, key="falsify"):
    """Whether the checkout meets the done line in a card's FALSIFY, and the reason.
    It runs only where HEAD is `commit`, the head the report names."""
    clause = DONE_CLAUSE.search(falsify)
    if clause is None:
        return False, f"unrunnable: the card's {key} has no `done when it prints [comparison] N` clause"
    wanted = DONE_PRINTS.match(clause.group(1).strip())
    command = falsify[: clause.start()].split(" prints ", 1)[0].strip()
    if wanted is None or not command:
        return False, "unrunnable: the done line names no command and `it prints [comparison] N`"
    comparison, number = wanted.group(1), int(wanted.group(2))
    head, want = resolve("HEAD"), resolve(commit) if commit else None
    if want is None or head != want:
        return False, (
            f"this checkout is at {head}, not at COMMIT {commit} ({want}): "
            "run the done line where the head is checked out"
        )
    try:
        ran = subprocess.run(["bash", "-o", "pipefail", "-c", command], capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        return False, f"unrunnable: `{command}` ran past 120 seconds"
    # A pipeline that counts matches exits 1 under pipefail when grep finds none, with
    # nothing on stderr. Any other failure, such as a missing path, is not a count.
    no_match = ran.returncode == 1 and not ran.stderr.strip()
    if ran.returncode != 0 and not no_match:
        return False, f"unrunnable: `{command}` exited {ran.returncode}: {ran.stderr.strip()}"
    printed = ran.stdout.strip()
    if not re.fullmatch(r"\d+", printed):
        return False, f"unrunnable: `{command}` printed {printed!r}, not one whole number"
    words = f"{comparison + ' ' if comparison else ''}{number}"
    return (
        DONE_COMPARES[comparison](int(printed), number),
        f"`{command}` printed {printed}; done when it prints {words}",
    )


def merge_base_says(base, commit):
    """Whether BASE is an ancestor of COMMIT in this checkout, and the reason if not."""
    ran = subprocess.run(
        ["git", "merge-base", "--is-ancestor", base + "^{commit}", commit + "^{commit}"],
        capture_output=True,
        text=True,
    )
    if ran.returncode == 0:
        return True, f"{base} is an ancestor of {commit}"
    if ran.returncode == 1:
        return False, f"{base} is not an ancestor of {commit}"
    return False, f"this checkout cannot compare {base} and {commit}: {ran.stderr.strip()}"


def resolve(rev):
    """The whole commit `rev` names in this checkout, or None."""
    ran = subprocess.run(
        ["git", "rev-parse", "--verify", "--quiet", rev + "^{commit}"],
        capture_output=True,
        text=True,
    )
    return ran.stdout.strip() if ran.returncode == 0 else None


def coverage_block(text):
    """The lines of the COVERAGE block below the header: from the line after the
    first `COVERAGE:` line to the first blank line. None when there is none."""
    lines = text.splitlines()
    for at, line in enumerate(lines):
        if line.strip() == "COVERAGE:":
            block = []
            for entry in lines[at + 1 :]:
                if not entry.strip():
                    break
                block.append(entry.strip())
            return block
    return None


def review_says(spec, text):
    """The review checks: every line they print, and whether all passed."""
    printed = []
    ok = True

    def fail(words):
        nonlocal ok
        ok = False
        printed.append(f"FAIL {words}")

    match = re.fullmatch(r"(\S+)\.\.(\S+)", spec)
    if not match:
        fail(f"REVIEW: {spec} is not BASE..H")
        return printed, ok
    base, head = match.groups()
    full_base, full_head = resolve(base), resolve(head)
    for name, full in ((base, full_base), (head, full_head)):
        if full is None:
            fail(f"REVIEW: this checkout holds no commit {name}")
    if full_base is None or full_head is None:
        return printed, ok
    ran = subprocess.run(
        ["git", "diff", "--name-only", "-z", f"{full_base}..{full_head}"],
        capture_output=True,
        text=True,
    )
    if ran.returncode != 0:
        fail(f"REVIEW: this checkout cannot list the range: {ran.stderr.strip()}")
        return printed, ok
    changed = [path for path in ran.stdout.split("\0") if path]
    printed.append(f"pass REVIEW: {spec} changes {len(changed)} files")

    block = coverage_block(text)
    if block is None:
        fail("COVERAGE: the report has no COVERAGE: block")
        return printed, ok
    scope, block = scope_of(block, changed, spec, fail)
    if scope is None:
        return printed, ok
    claimed = {}
    for line in block:
        entry = re.fullmatch(r"(.+?) (read-by|UNREAD)(?: (.*))?", line)
        if not entry:
            fail(f"COVERAGE: a line that is neither `<path> read-by <reader>` nor `<path> UNREAD <reason>`: {line}")
            continue
        path, kind, rest = entry.group(1), entry.group(2), (entry.group(3) or "").strip()
        if path not in changed:
            fail(f"COVERAGE: {path} is not a file of {spec}")
        elif kind == "UNREAD":
            fail(f"COVERAGE: {path} is UNREAD" + (f": {rest}" if rest else ""))
        elif not rest:
            fail(f"COVERAGE: {path} names no reader")
        elif claimed.get(path) is None:
            claimed[path] = rest
    required = changed if scope == [] else scope
    for path in required:
        if path not in claimed and not any(
            line.startswith(path + " ") for line in block
        ):
            fail(
                f"COVERAGE: {path} changed in {spec} and has no line"
                if scope == []
                else f"COVERAGE: {path} is in the lens's INVENTORY and has no line"
            )
    read = sum(1 for path in required if path in claimed)
    if ok and scope == []:
        printed.append(f"pass COVERAGE: all {read} changed files are marked read")
    elif ok:
        printed.append(
            f"pass COVERAGE: all {read} files of the lens's scope are marked read"
            f" ({len(changed)} files in the range)"
        )
    return printed, ok


# The git listings an INVENTORY line may name. Each only lists paths.
INVENTORY_VERBS = ("diff", "ls-files", "ls-tree")
# The options an INVENTORY may carry before `--`: those that choose which files a
# listing names or how it prints them. Anything else is refused, because git
# options can write a file (diff --output) or run a program (--ext-diff).
INVENTORY_FLAG = re.compile(
    r"-z|-r|-o|-c|-m|-d|-s|-M"
    r"|--(name-only|name-status|cached|staged|full-name|others|modified|deleted"
    r"|exclude-standard|no-renames|relative(=.*)?|diff-filter=[A-Za-z]+)"
)


def scope_of(block, changed, spec, fail):
    """**The files a scoped lens owes, and the block without its INVENTORY lines.**

    A block with no `INVENTORY: <git command>` line owes the whole range, and the
    scope is []. Each INVENTORY line names a read-only git listing, run in the
    current checkout without a shell; the scope is the union of what they print.
    Returns (None, block) when an inventory is refused: it is not a git listing,
    it fails, it lists nothing, or it lists a file outside the range."""
    prefix = "INVENTORY:"
    commands = [line[len(prefix):].strip() for line in block if line.startswith(prefix)]
    rest = [line for line in block if not line.startswith(prefix)]
    if not commands:
        return [], rest
    scope = []
    refused = False
    for command in commands:
        try:
            words = shlex.split(command)
        except ValueError as err:
            fail(f"INVENTORY: `{command}` cannot be read: {err}")
            refused = True
            continue
        if len(words) < 2 or words[0] != "git" or words[1] not in INVENTORY_VERBS:
            fail(
                f"INVENTORY: `{command}` is not a git listing"
                f" (git {' | '.join(INVENTORY_VERBS)})"
            )
            refused = True
            continue
        before_paths = words[2 : words.index("--")] if "--" in words else words[2:]
        odd = [w for w in before_paths if w.startswith("-") and not INVENTORY_FLAG.fullmatch(w)]
        if odd:
            fail(
                f"INVENTORY: `{command}` has the option {odd[0]}, which a listing does not"
                " take (an option such as --output writes a file); the options allowed are"
                " those that choose which files are listed"
            )
            refused = True
            continue
        ran = subprocess.run(words, capture_output=True, text=True)
        listed = [path for path in re.split(r"[\0\n]", ran.stdout) if path]
        if ran.returncode != 0:
            fail(f"INVENTORY: `{command}` failed: {ran.stderr.strip()}")
            refused = True
        elif not listed:
            fail(f"INVENTORY: `{command}` lists no file, so it proves no scope")
            refused = True
        for path in listed:
            if path not in changed:
                fail(f"INVENTORY: {path} is not a file of {spec}")
                refused = True
            elif path not in scope:
                scope.append(path)
    return (None if refused else scope), rest


def json_head(wr, branch):
    """The commit the forge holds as the head of `branch`."""
    return json.loads(wr.fetch("/branches/" + urllib.parse.quote(branch, safe="")))["commit"]["id"]


def main():
    wr = wait_run()
    args = sys.argv[1:]
    if args and (len(args) != 2 or args[0] != "--card"):
        print("usage: scripts/check-report [--card FILE] < report.txt", file=sys.stderr)
        sys.exit(2)
    text = sys.stdin.read()
    header = header_of(text)
    review = header.get("REVIEW")
    card_falsify, done_key = None, "falsify"
    if args and not review:
        with open(args[1]) as handle:
            card = json.load(handle)
        header = with_card(header, card)
        done_key = next((key for key in ("done_line", "falsify") if card_value(card, (key,))), "falsify")
        card_falsify = card_value(card, (done_key,)) or ""
    if not wr.API and not (review and not any(key in header for key in KEYS)):
        print("WAIT_RUN_API is not set: set it to the repository's API root", file=sys.stderr)
        sys.exit(4)
    commit, branch = header.get("COMMIT"), header.get("BRANCH")
    results = {}

    head = None
    if branch is not None:
        try:
            head = json_head(wr, branch)
            results["BRANCH"] = (True, f"the forge holds {branch}")
        except wr.Gone:
            results["BRANCH"] = (False, f"the forge holds no branch {branch}")
        except (urllib.error.URLError, TimeoutError, OSError) as err:
            results["BRANCH"] = (False, f"the forge did not answer: {err}")

    full = None
    if commit is not None and re.fullmatch(r"[0-9a-f]{40}", commit):
        full = commit
    elif commit is not None and head and len(commit) >= 7 and head.startswith(commit):
        full = head
    if commit is not None and branch is not None and "BRANCH" in results and results["BRANCH"][0]:
        if head == commit or (len(commit) >= 7 and head.startswith(commit)):
            results["COMMIT"] = (True, f"{commit} is the head of {branch}")
        else:
            results["COMMIT"] = (False, f"{commit} is not the head of {branch}, which is {head}")

    if "BASE" in header and commit is not None:
        results["BASE"] = merge_base_says(header["BASE"], commit)

    if "RUN" in header and commit is not None and branch is not None:
        if full is None:
            results["RUN"] = (False, f"{commit} is not a whole commit the forge head can complete")
        elif not re.fullmatch(r"#?\d+", header["RUN"]):
            results["RUN"] = (False, f"{header['RUN']} is not a run number")
        else:
            number = int(header["RUN"].lstrip("#"))
            try:
                runs = wr.runs_of(head_sha=full)
            except wr.Gone:
                runs = None
                results["RUN"] = (False, "the forge has no run list at the API root")
            except (urllib.error.URLError, TimeoutError, OSError) as err:
                runs = None
                results["RUN"] = (False, f"the forge did not answer: {err}")
            if runs is not None:
                # The run number is the run's index in the repository: what wait-run
                # prints first and what a line writes into ci_run.
                of_commit = [r for r in runs if r["commit_sha"] == full]
                mine = [r for r in of_commit if r.get("index_in_repo") == number]
                by_forge_id = [r for r in of_commit if r["id"] == number and r.get("index_in_repo") is not None]
                if not mine and by_forge_id:
                    use = by_forge_id[0]["index_in_repo"]
                    results["RUN"] = (False, f"{number} is the forge id of run #{use}; write RUN: {use}")
                elif not mine:
                    results["RUN"] = (False, f"{number} is not a run number of {full}")
                elif mine[0]["prettyref"] != branch:
                    results["RUN"] = (False, f"run {number} is on {mine[0]['prettyref']}, not {branch}")
                elif mine[0]["status"] != "success":
                    results["RUN"] = (False, f"run {number} is {mine[0]['status']}")
                else:
                    results["RUN"] = (True, f"run {number} of {full} on {branch} succeeded")

    for key in NAMED:
        if key in header:
            results[key] = (True, "named")
    shape = locator_shape(header.get("FALSIFY", ""))
    if shape:
        results["FALSIFY"] = (
            False,
            f"{shape} goes stale when the code moves: falsify by name, with git grep for "
            "the function, string or key",
        )
    if card_falsify is not None:
        results["DONE"] = done_says(card_falsify, commit, done_key)
    if re.fullmatch(r"(?i)none\W*", header.get("RETIRES", "")):
        results["RETIRES"] = (False, "none needs its reason")
    if re.search(r"^net lines by area since \S+", text, re.M) and re.search(r"total; source plus tests", text):
        header["NET"] = "table"
        results["NET"] = (True, "the report holds the net table")

    wanting = {
        "COMMIT": ("BRANCH",),
        "BASE": ("COMMIT",),
        "RUN": ("COMMIT", "BRANCH"),
    }
    ok = True
    for key in KEYS:
        if key not in header:
            if review:
                continue
            print(f"FAIL {key}: " + ("no net table in the report" if key == "NET" else "missing from the header"))
            ok = False
        elif key in results:
            good, words = results[key]
            print(f"{'pass' if good else 'FAIL'} {key}: {words}")
            ok = ok and good
        else:
            lacking = [o for o in wanting.get(key, ()) if o not in header]
            print(f"FAIL {key}: cannot be checked, {', '.join(lacking) or 'a check it needs'} missing")
            ok = False
    if "DONE" in results:
        good, words = results["DONE"]
        print(f"{'pass' if good else 'FAIL'} DONE: {words}")
        ok = ok and good
    if review:
        printed, review_ok = review_says(review, text)
        for line in printed:
            print(line)
        ok = ok and review_ok
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
