#!/bin/sh
# Run a command, and stop it as FAILED when a sibling job of the same run has failed.
#
#   scripts/stop-with-siblings <command...>
#
# The jobs of a run are independent, so a job that failed at minute two leaves its
# siblings running for a verdict nobody needs. A job that wraps its long step in
# this script asks the run for its jobs every STOP_POLL_SECONDS (15) and, on the
# first sibling that failed, kills the command, says which sibling failed first,
# and exits 75. The job then reads failed, as its sibling does, and the run reads
# failed: nothing is cancelled, so no job reads like a superseded push or an infra
# stop. Exit code 75 and the line "stopped: <job> failed first; this job has no
# verdict of its own" tell a stopped job from a red one. A job that failed itself
# is stopped by the sibling that still runs, which wraps its own step the same way.
#
# **A failure counts only if its attempt is this job's attempt or a later one.**
# The forge re-runs one job and leaves the others as they were, so a sibling that
# failed in an earlier attempt still reads `failure` while this job runs again.
# The jobs endpoint gives each job an `attempt` and no times and no steps, so
# "first" is the first failed job the endpoint lists.
#
# The read of a run's jobs needs no credential. A run that is already over, or a
# newer push that cancelled it, has no job in `failure`, so nothing is stopped.
# Without GITHUB_API_URL, GITHUB_REPOSITORY and GITHUB_RUN_ID the command runs
# alone. A TOKEN in the environment is not passed to the command.
run="${GITHUB_API_URL:-}/repos/${GITHUB_REPOSITORY:-}/actions/runs/${GITHUB_RUN_ID:-}"
attempt_of() {
    sed -n 's/.*"attempt":\([0-9][0-9]*\).*/\1/p'
}
# One job to a line: the endpoint answers a flat list of objects with no nesting.
# Prints the name of the first failed sibling that counts, and nothing otherwise.
failed_sibling() {
    jobs=$(curl -fsS "$run/jobs" 2>/dev/null | tr '}' '\n') || return 1
    own=$(printf '%s\n' "$jobs" | grep "\"name\":\"${GITHUB_JOB:-}\"" | attempt_of | head -n 1)
    printf '%s\n' "$jobs" | grep '"status":"failure"' | grep -v "\"name\":\"${GITHUB_JOB:-}\"" |
        while read -r line; do
            attempt=$(printf '%s\n' "$line" | attempt_of)
            [ "$attempt" -ge "${own:-0}" ] || continue
            printf '%s\n' "$line" | sed -n 's/.*"name":"\([^"]*\)".*/\1/p'
            break
        done
}
stopped_by=$(mktemp)
# Its own process group (job control gives each background job one; setsid is not
# on every runner's PATH), so a stop reaches the programs the command started and
# not only the command itself.
set -m
env -u TOKEN "$@" &
child=$!
set +m
if [ -n "${GITHUB_API_URL:-}" ] && [ -n "${GITHUB_RUN_ID:-}" ]; then
    (
        while sleep "${STOP_POLL_SECONDS:-15}"; do
            name=$(failed_sibling)
            if [ -n "$name" ]; then
                printf '%s\n' "$name" >"$stopped_by"
                kill -- "-$child" 2>/dev/null
                break
            fi
        done
    ) &
    watcher=$!
fi
stop() { [ -z "${watcher:-}" ] || kill "$watcher" 2>/dev/null; rm -f "$stopped_by"; }
trap stop EXIT
trap 'stop; kill -- "-$child" 2>/dev/null; exit 130' INT
trap 'stop; kill -- "-$child" 2>/dev/null; exit 143' TERM
wait "$child"
code=$?
if [ -s "$stopped_by" ]; then
    echo "stop-with-siblings: stopped: $(cat "$stopped_by") failed first; this job has no verdict of its own" >&2
    exit 75
fi
exit "$code"
