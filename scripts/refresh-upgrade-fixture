#!/usr/bin/env bash
# Records the fixture crates/jojobot/tests/fixtures/upgrade/ carries, from a
# binary built at a named ref — never from this checkout's own working tree.
#
#     scripts/refresh-upgrade-fixture [REF [DIR]]
#
# REF defaults to origin/main. DIR is the fixture directory to record into,
# relative to crates/jojobot, and defaults to the gate's first fixture; the gate
# keeps a second one (tests/fixtures/upgrade_deploy3) for the build deploy 3
# shipped. The ref is built in a DETACHED worktree, so
# this script never moves this checkout's HEAD and never creates a branch.
# The worktree is removed on exit, success or failure alike.
set -euo pipefail

REF="${1:-origin/main}"
FIXTURE_DIR="${2:-}"
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RESOLVED="$(git -C "$REPO_ROOT" rev-parse --short "$REF")"
WORKTREE_DIR="$(mktemp -d)"

cleanup() {
    cd "$REPO_ROOT"
    git worktree remove --force "$WORKTREE_DIR" 2>/dev/null || rm -rf "$WORKTREE_DIR"
}
trap cleanup EXIT

echo "building $REF ($RESOLVED) in a detached worktree at $WORKTREE_DIR"
git -C "$REPO_ROOT" worktree add --detach "$WORKTREE_DIR" "$RESOLVED"

# **The worktree builds into a target directory of its own.** The devShell
# points CARGO_TARGET_DIR at one directory shared by every checkout, and a
# build of an older ref written there is served to the next build of this
# checkout in place of its own crates. `env` runs after the shell hook, so it
# wins over the hook's value. The directory goes with the worktree.
WORKTREE_TARGET="$WORKTREE_DIR/target"
(cd "$WORKTREE_DIR" && nix develop -c env CARGO_TARGET_DIR="$WORKTREE_TARGET" cargo build -p jojobot)

BINARY="$WORKTREE_TARGET/debug/jojobot"
if [ ! -x "$BINARY" ]; then
    echo "REFRESH REFUSED: no binary at $BINARY after building $REF" >&2
    exit 1
fi

echo "recording the fixture from $BINARY ($RESOLVED)"
cd "$REPO_ROOT"
UPGRADE_FIXTURE_BINARY="$BINARY" UPGRADE_FIXTURE_REF="$RESOLVED" \
    UPGRADE_FIXTURE_DIR="$FIXTURE_DIR" \
    nix develop -c cargo test -p jojobot --test record_upgrade_fixture -- --ignored --nocapture
