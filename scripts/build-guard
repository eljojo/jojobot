#!/usr/bin/env python3
"""**Refuse a target dir that is not this line's own, and clean up after a build that was killed.**

    scripts/build-guard <command...>

make dev and make narrow run their command through this, ahead of the first
cargo run: cargo compiles the bar before the bar runs, so a check inside the bar
is too late.

OWNERSHIP. The checkout says which target dir is the line's own: the
target_directory that `cargo metadata` reports must be named after the checkout
this script lives in (a line's checkout and its dir share a name), or be the
checkout's own `target`. A shared root or another line's dir refuses with exit 2
and one line saying what was expected and what was found. Nothing is read from
the environment, because a launch cannot be relied on to set it.

RECOVERY. Before the command compiles anything the guard writes a marker in the
target dir with a snapshot of the units in debug/incremental; the command waits
for that. A command that ends by itself, red or green, removes the marker and
nothing else; one that a signal ends keeps it. A SIGKILL runs no handler, so the marker survives it. The next run
kills the recorded process group, leader gone or not, and waits until it is
empty. Only then does it measure the units, remove those whose files changed or
appeared since the snapshot, remove the marker, and run. It never touches deps,
fingerprints, other units or another dir. If debug/ or the incremental root or a
unit leads out of the target dir, or the run that wrote the marker is still
alive, it refuses and leaves everything as it is.
"""
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

CHECKOUT = Path(__file__).resolve().parent.parent


class Refused(Exception):
    pass


def start_time(pid):
    """The start time of a process in clock ticks, to tell a process from a reused id."""
    try:
        return Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, IndexError):
        return None


def confine(found, incremental):
    """Refuse a debug dir or an incremental root that leads out of the owned target dir."""
    for path in (found / "debug", incremental):
        if path.is_symlink() or not path.resolve().is_relative_to(found.resolve()):
            raise Refused(f"{path} leads out of the target dir {found}; nothing was removed")


def reap(state):
    """Kill what is left of the dead run's process group and wait until it is gone."""
    pgid = state["pgid"]
    leader = start_time(pgid)
    if leader is not None and leader != state.get("start"):
        return  # the id belongs to another process now
    try:
        os.killpg(pgid, signal.SIGKILL)
        for _ in range(100):
            os.killpg(pgid, 0)
            time.sleep(0.05)
    except ProcessLookupError:
        return
    except PermissionError:
        pass
    raise Refused(f"the process group {pgid} of the dead run did not end")


def snapshot(incremental):
    """Each unit of the incremental cache with a digest of its files' names, sizes and times."""
    units = {}
    for unit in sorted(incremental.iterdir()) if incremental.is_dir() else []:
        if unit.is_symlink() or not unit.resolve().is_relative_to(incremental.resolve()):
            raise Refused(f"{unit} leads out of the incremental cache; nothing was removed")
        files = []
        for d, _, names in os.walk(unit):
            for f in sorted(names):
                info = Path(d, f).lstat()
                files.append((d, f, info.st_size, info.st_mtime_ns))
        units[unit.name] = hashlib.sha1(repr(files).encode()).hexdigest()
    return units


def recover(marker, incremental):
    """Undo what a killed run left: reap its group, remove the units it touched."""
    state = json.loads(marker.read_text())
    if start_time(state["pid"]) is not None and state["pid"] != os.getpid():
        raise Refused(f"the run that left {marker} (pid {state['pid']}) is still running")
    reap(state)
    now = snapshot(incremental)
    for name, signature in now.items():
        if state["units"].get(name) != signature:
            shutil.rmtree(incremental / name)
    marker.unlink()


def target_dir():
    answer = subprocess.run([os.environ.get("CARGO", "cargo"), "metadata", "--no-deps",
                             "--format-version", "1"], capture_output=True, text=True)
    try:
        return Path(json.loads(answer.stdout)["target_directory"])
    except (ValueError, KeyError):
        raise Refused("cargo metadata did not report a target_directory")


def main(command):
    try:
        found = target_dir()
        if found.resolve() != CHECKOUT / "target" and found.resolve().name != CHECKOUT.name:
            raise Refused(f"expected a target dir named {CHECKOUT.name} or {CHECKOUT / 'target'}, "
                          f"found {found}")
        incremental, marker = found / "debug" / "incremental", found / ".build-guard.json"
        confine(found, incremental)
        if marker.exists():
            recover(marker, incremental)
        units = snapshot(incremental)
    except Refused as why:
        print(f"build guard: {why}", file=sys.stderr)
        return 2
    found.mkdir(parents=True, exist_ok=True)
    # The command waits for a byte on a pipe, so it cannot compile before the marker
    # is on disk. If this process dies first, the pipe closes and the command exits.
    ready, release = os.pipe()
    child = subprocess.Popen(["sh", "-c", 'read go <&$0 || exit 1; exec "$@"', str(ready), *command],
                             pass_fds=(ready,), start_new_session=True)
    os.close(ready)
    try:
        marker.write_text(json.dumps({"pid": os.getpid(), "pgid": child.pid,
                                      "start": start_time(child.pid), "units": units}))
    except OSError as why:
        os.close(release)
        child.wait()
        print(f"build guard: the marker could not be written, so nothing was started: {why}",
              file=sys.stderr)
        return 2
    os.write(release, b"go\n")
    os.close(release)
    code = child.wait()
    if code < 0:
        # A signal ended the command, so the build was cut short: keep the marker.
        return 128 - code
    marker.unlink(missing_ok=True)
    return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]) if sys.argv[1:] else 2)
