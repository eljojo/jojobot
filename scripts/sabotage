#!/usr/bin/env python3
"""**A sabotage that cannot leave a dirty tree.**

Watching a test fail means breaking the code it covers and seeing the red.
Doing that in two steps — mutate, then restore — puts a decision between them,
and a decision is where reflex lives: the tree is dirty, restoring is a thing
somebody chooses to do, and the convenient way to choose it is a git verb the
operator has closed.

So this is ONE act. It keeps the file, mutates it, runs what you asked, prints
the verdict, and puts the file back — and the putting back is in a `finally`
with the signals wired into it, so it happens when the run passes, fails,
raises, or is asked to stop. **There is no interval during which the tree is
observably dirty, so there is nothing for a prohibited verb to be the answer
to.**

    scripts/sabotage <file> <from> <to> -- <command...>

**A GREEN verdict is two different results and it used to print as one.** A
sabotage that stays green either means the case does not depend on that site —
so the sabotage measured nothing — or it means the site is a genuine negative
control. **Reachability cannot tell those apart**: a line can run and still have
nothing assert on what it computed, which is the commoner of the two.

So a green verdict is followed by a PROBE: the same site, replaced with a
`panic!`, and the same command run again. A panic is the most observable
mutation there is, so a case that survives one is blind to that site whether
the line ran or not — which is the question a negative control was always
asking. **It runs only on green**, because a red verdict has already proved the
case depends on the site.

**The probe can fail to be written at all** — not every site is a place a
`panic!` can stand — and that is reported as neither colour. ⚠️ A compile
failure read as *blind* would tell somebody their case is worthless when
nothing was measured.

⚠️ **A probe roughly doubles a sabotage**, and the tool says so before it runs
one.

**It refuses unless the text it is replacing appears EXACTLY ONCE.** Asserting
that a sabotage applied is not enough when a file has more than one site that
looks like the target: a patch that lands somewhere else changes something,
passes a did-anything-move check, and reports a verdict about code nobody
touched. The uniqueness check is that rule, held here rather than by whoever is
driving.

⚠️ **It touches git not at all** — not to keep the file, not to put it back.
A tool built to stop somebody reaching for a closed verb cannot reach for one.

⚠️ **`SIGKILL` cannot be caught, by this or by anything.** A hard kill of this
process leaves the file mutated, and the copy is named on stdout when the run
starts so a person can put it back by hand. That is the one hole and it is
stated rather than papered over.
"""

import os
import shutil
import signal
import subprocess
import sys
import tempfile


USAGE = "usage: scripts/sabotage <file> <from> <to> -- <command...>"


def refuse(why):
    print(f"REFUSED: {why}", file=sys.stderr)
    return 2


def main(argv):
    broken = self_check()
    if broken:
        return refuse(broken)
    if argv == ["--self-check"]:
        print(f"SABOTAGE SELF-CHECK: {len(CHECKS)} classifier cases hold")
        return 0
    if "--" not in argv:
        return refuse(USAGE)
    split = argv.index("--")
    named, command = argv[:split], argv[split + 1 :]
    if len(named) != 3 or not command:
        return refuse(USAGE)
    path, old, new = named

    if not os.path.isfile(path):
        return refuse(f"{path} is no file")
    before = open(path, encoding="utf-8").read()

    # **The site has to be the one you meant.** A needle matching twice is a
    # sabotage that will land somewhere, move something, and report a verdict
    # about whichever site it happened to hit.
    found = before.count(old)
    if found != 1:
        return refuse(
            f"the text to replace appears {found} times in {path} and it has to appear once, "
            f"so the sabotage lands where you meant it to"
        )
    after = before.replace(old, new, 1)
    if after == before:
        return refuse("the replacement leaves the file unchanged, so nothing would be sabotaged")

    kept = tempfile.NamedTemporaryFile(
        prefix="sabotage-", suffix=os.path.basename(path), delete=False
    ).name
    shutil.copyfile(path, kept)
    print(f"SABOTAGE {path}: kept at {kept}", flush=True)

    # **Asked to stop is a way of ending, not a way of skipping the restore.**
    # Turning the signal into an exception is what lets one `finally` cover
    # every ending this process has.
    def stop(number, _frame):
        raise SystemExit(128 + number)

    for asked in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(asked, stop)

    try:
        with open(path, "w", encoding="utf-8") as writing:
            writing.write(after)
        # **Read back rather than trusted.** The write is what the verdict
        # below is a verdict about, and a write that did not land would make
        # every run after it a report on code nobody changed.
        applied = open(path, encoding="utf-8").read()
        if applied != after:
            return refuse(f"{path} did not take the sabotage, so no verdict here means anything")
        print(f"SABOTAGE APPLIED to the one site in {path}", flush=True)

        ran = subprocess.run(command)
        verdict = "RED" if ran.returncode != 0 else "GREEN"
        print(
            f"SABOTAGE VERDICT {verdict}: {' '.join(command)} exited {ran.returncode}",
            flush=True,
        )
        if ran.returncode == 0:
            probe(path, before, old, command)
        return ran.returncode
    finally:
        shutil.copyfile(kept, path)
        os.unlink(kept)
        print(f"SABOTAGE RESTORED {path}", flush=True)


# **What the probe puts at the site.** The marker is ours rather than the
# runner's, which is what lets a probe that panicked be told from a probe that
# would not compile: both leave a non-zero exit code, and only one of them says
# this.
#
# ⚠️ **Finding the marker anywhere in the output is not enough, and reading it
# that way got the first run of this wrong.** A compiler warning quotes the
# source line it is about, marker and all, so a probe that compiled with a
# warning and never fired was read as having fired. **A panic prints its
# message as a line of its own**, where a quoted source line always carries the
# compiler's gutter — so the test is a whole line rather than a substring.
MARKER = "SABOTAGE-PROBE-REACHED-THIS-SITE"
PANIC = f'panic!("{MARKER}")'


def probe_text(old):
    """**A `panic!` that can stand where `old` stood**, or `None`.

    Two shapes, because two cover nearly every site a sabotage names and a
    third rule would be guessing at Rust with a regular expression.

    `key: value,` keeps its key and its comma: a struct field replaced whole
    leaves the field missing and the literal broken. Anything else becomes the
    panic alone, keeping a trailing comma or semicolon if there was one.

    **Neither shape is checked for sense here.** Whether it compiles is the
    compiler's answer, and the run below reports it as one.
    """
    body = old.rstrip()
    if not body.strip():
        return None
    lead = body[: len(body) - len(body.lstrip())]
    tail = body[-1] if body[-1:] in ",;" else ""
    inner = body.strip().rstrip(",;")
    key, colon, _ = inner.partition(":")
    if colon and key.strip().replace("_", "").isalnum() and "\n" not in key:
        return f"{lead}{key.strip()}: {PANIC}{tail or ','}"
    if "\n" in body:
        return None
    return f"{lead}{PANIC}{tail}"


DEPENDED_ON = "DEPENDED ON"
BLIND = "BLIND"
NOT_MEASURED = "NOT MEASURED"

SAYS = {
    DEPENDED_ON: (
        "DEPENDED ON — a panic here is noticed, so the green above is a genuine negative "
        "control and says something about the code"
    ),
    BLIND: (
        "BLIND — a panic here is not noticed, so the green above measured NOTHING. The case "
        "does not depend on this site; sabotage the one it does."
    ),
    NOT_MEASURED: (
        "NOT MEASURED — the probe did not run and did not panic, so this says nothing either "
        "way. The output above is why; usually the panic could not be written where the site "
        "stands."
    ),
}


def classify(said, returncode):
    """**Which kind of green, from the probe's output and its exit code.**

    A pure function over strings, because it is the part that has been wrong:
    the first version asked whether the marker appeared anywhere in the output
    and was fooled by the compiler quoting the very line it had just been asked
    to compile. **A panic prints its message as a line of its own**, and a
    quoted source line always carries the compiler's gutter, so the test is a
    whole line rather than a substring.

    A run that neither panicked nor succeeded says nothing: usually the panic
    could not be written where the site stands. **Reporting that as BLIND would
    tell somebody their case is worthless when nothing was measured.**
    """
    if any(line.strip() == MARKER for line in said.splitlines()):
        return DEPENDED_ON
    return BLIND if returncode == 0 else NOT_MEASURED


# **The four inputs are real output, kept as it arrived.** The first is what
# actually fooled this classifier: the probe compiled, warned, never fired, and
# the compiler echoed the marker back inside a quoted source line. A
# reconstruction of that would have been written by somebody who already knew
# the answer.
CHECKS = (
    (
        "the compiler echoing the marker in a warning is not a panic",
        'warning: unreachable expression\n'
        '1247 | | ...                       retracted: panic!("SABOTAGE-PROBE-REACHED-THIS-SITE"),\n'
        "warning: `jojobot-domain` (lib) generated 2 warnings\n",
        0,
        BLIND,
    ),
    (
        "a panic prints its message as a line of its own",
        "thread 'memory::graph::tests::the_scopes_part_company' (3901737) panicked at "
        "crates/jojobot-domain/src/memory/graph.rs:218:9:\n"
        "SABOTAGE-PROBE-REACHED-THIS-SITE\n"
        "note: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n",
        101,
        DEPENDED_ON,
    ),
    (
        "a clean pass with the marker nowhere is blind",
        "test result: ok. 1 passed; 0 failed; 0 ignored; 189 filtered out\n",
        0,
        BLIND,
    ),
    (
        "a probe that would not compile measured nothing",
        "error: expected one of `,` or `}`, found `panic`\n"
        "error: could not compile `jojobot-domain` (lib test)\n",
        101,
        NOT_MEASURED,
    ),
)


def self_check():
    """**The classifier answers for itself before it answers about anything.**

    It runs on every sabotage rather than in the bar, because the moment it is
    about to be relied on is the moment worth checking it — and because it is
    four string comparisons.

    ⛔️ **A broken classifier is not a silence to fall back to.** It prints
    DEPENDED ON over a blind case, which is an active mis-certification of the
    one thing this tool exists to catch, so a failure here refuses rather than
    warns.
    """
    for why, said, code, wanted in CHECKS:
        got = classify(said, code)
        if got != wanted:
            return f"the probe classifier is wrong — {why}: said {got}, and it has to say {wanted}"
    return None


def probe(path, before, old, command):
    """**Which kind of green that was**, printed and never enforced."""
    text = probe_text(old)
    if text is None:
        print(
            "SABOTAGE PROBE SKIPPED: no panic can be written at this site, so which kind of "
            "green this is was not measured",
            flush=True,
        )
        return
    print(
        "SABOTAGE PROBING which kind of green: a panic at the same site, same command. "
        "This roughly doubles the run.",
        flush=True,
    )
    with open(path, "w", encoding="utf-8") as writing:
        writing.write(before.replace(old, text, 1))
    ran = subprocess.run(command, capture_output=True, text=True)
    verdict = classify(ran.stdout + ran.stderr, ran.returncode)
    if verdict == NOT_MEASURED:
        print(ran.stdout + ran.stderr, flush=True)
    print(f"SABOTAGE PROBE: {SAYS[verdict]}", flush=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
