#!/usr/bin/env python3
"""**A sabotage that cannot leave a dirty tree.**

Watching a test fail means breaking the code it covers and seeing the red.
Doing that in two steps — mutate, then restore — puts a decision between them,
and a decision is where reflex lives: the tree is dirty, restoring is a thing
somebody chooses to do, and the convenient way to choose it is a git verb the
operator has closed.

So this is ONE act. It keeps the file, mutates it, runs what you asked, prints
the verdict, and puts the file back — and the putting back is in a `finally`
with the signals wired into it, so it happens when the run passes, fails,
raises, or is asked to stop. **There is no interval during which the tree is
observably dirty, so there is nothing for a prohibited verb to be the answer
to.**

    scripts/sabotage <file> <from> <to> -- <command...>

**A GREEN verdict is two different results and it used to print as one.** A
sabotage that stays green either means the case does not depend on that site —
so the sabotage measured nothing — or it means the site is a genuine negative
control. **Reachability cannot tell those apart**: a line can run and still have
nothing assert on what it computed, which is the commoner of the two.

So a green verdict is followed by a PROBE: the same site, replaced with a
`panic!`, and the same command run again. A panic is the most observable
mutation there is, so a case that survives one is blind to that site whether
the line ran or not — which is the question a negative control was always
asking. **It runs only on green**, because a red verdict has already proved the
case depends on the site.

**The probe can fail to be written at all** — not every site is a place a
`panic!` can stand — and that is reported as neither colour. ⚠️ A compile
failure read as *blind* would tell somebody their case is worthless when
nothing was measured.

**A break that does not compile is neither colour either**, and it has an exit
code of its own, 3. Cargo writes its errors to stderr and stops before any test,
so the run ended non-zero with nothing on the stream the tool once read, and
was reported as RED: the word for a case that caught the break. Nothing had been
measured. The tool now reads both streams, says `VERDICT DID NOT COMPILE`, runs
no probe, and the compiler's error is above it.

⚠️ **A probe roughly doubles a sabotage**, and the tool says so before it runs
one.

**It refuses unless the text it is replacing appears EXACTLY ONCE.** Asserting
that a sabotage applied is not enough when a file has more than one site that
looks like the target: a patch that lands somewhere else changes something,
passes a did-anything-move check, and reports a verdict about code nobody
touched. The uniqueness check is that rule, held here rather than by whoever is
driving.

**It refuses a run in which no test executed, before any verdict.** A test
filter that matches nothing makes the runner exit zero, which used to print
GREEN for a sabotage that measured nothing. The count is read from the runner's
`test result:` lines, summed over every target, and the probe run is held to it
too: an empty probe is reported as EMPTY, never as BLIND.

⚠️ **It touches git not at all** — not to keep the file, not to put it back.
A tool built to stop somebody reaching for a closed verb cannot reach for one.

⚠️ **`SIGKILL` cannot be caught, by this or by anything.** A hard kill of this
process leaves the file mutated, and the copy is named on stdout when the run
starts so a person can put it back by hand. **That copy's own path used to be
the only record of it** — printed once, to a terminal that scrolls, with
nothing else that remembered it. A later invocation has nothing to look for
and the evidence goes with the scrollback, which is the gap this closes: every
invocation writes where it is about to mutate before it does, clears that
record once it restores, and a later invocation that finds one left behind
says so — the file, and the exact command that puts it back. It never gates:
a caller that ignores the notice is exactly as free to run as before.
"""

import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading


USAGE = "usage: scripts/sabotage <file> <from> <to> -- <command...>"

# **Where an in-flight mutation is recorded, so a later invocation can find
# what a hard kill left behind.** `SABOTAGE_STATE_DIR` is a caller's override
# — the test suite sets it, so concurrent test runs each get their own
# directory. Outside a test, the default is a fixed path under the system temp
# directory: fixed, so a later invocation looks in the same place the
# interrupted one wrote to, and under the temp directory rather than the
# tracked tree, so there is nothing here for git to see.
#
# ⚠️ **One file per run, never one file for all of them.** Every line shares
# this directory, and one file that each run read and rewrote whole lost an
# entry when two runs started or ended together: the second write carried the
# list the first had not yet joined. A run now writes and removes only its own
# file, so no run can drop another's entry.
STATE_DIR = os.environ.get("SABOTAGE_STATE_DIR") or os.path.join(
    tempfile.gettempdir(), "jojobot-sabotage"
)
RECORD_PREFIX = "run-"

# **The checkout this copy of the tool lives in**, which is what makes a record
# one line's own. Every line has its own checkout and so its own copy, so a
# record names its checkout and the startup report names only the records of
# the checkout it runs from.
CHECKOUT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def _record_path(kept):
    return os.path.join(STATE_DIR, RECORD_PREFIX + os.path.basename(kept))


def _records():
    """Every record on disk as `(record file, checkout, pid, target, kept)`."""
    if not os.path.isdir(STATE_DIR):
        return []
    found = []
    for name in sorted(os.listdir(STATE_DIR)):
        if not name.startswith(RECORD_PREFIX):
            continue
        record = os.path.join(STATE_DIR, name)
        try:
            with open(record, encoding="utf-8") as reading:
                fields = reading.read().rstrip("\n").split("\t")
        except OSError:
            continue
        if len(fields) == 4 and all(fields) and fields[1].isdigit():
            checkout, pid, target, kept = fields
            found.append((record, checkout, int(pid), target, kept))
    return found


def _running(pid):
    """**Whether a process by that number is still there.** A permission error
    means it is, owned by somebody else."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def mark_in_flight(path, kept):
    """**Written before the mutation, so a hard kill still leaves a trace.**

    Nothing after this line is guaranteed to run — that is the whole reason
    it exists — so everything this record needs has to be true already. It is
    written to a name of its own and renamed into place, so a reader never
    sees half a record.
    """
    os.makedirs(STATE_DIR, exist_ok=True)
    record = _record_path(kept)
    partial = record + ".partial"
    with open(partial, "w", encoding="utf-8") as writing:
        writing.write(f"{CHECKOUT}\t{os.getpid()}\t{path}\t{kept}\n")
    os.replace(partial, record)


def clear_in_flight(path, kept):
    """**Written after the restore, in the same `finally` that performs it.**

    Reached by every catchable ending — a pass, a fail, a raise, `SIGINT`,
    `SIGTERM`, `SIGHUP` — which is exactly the set this record does not need
    to survive. Only `SIGKILL` skips it, which is the one case the record is
    for.
    """
    try:
        os.unlink(_record_path(kept))
    except FileNotFoundError:
        pass


def report_outstanding():
    """**What an earlier run in this checkout left mutated, named with its own
    restore command.**

    Runs first, in every invocation, whatever that invocation goes on to do —
    it is a report, never a gate, so a caller ignoring it is exactly as free
    to run as one who never saw it.

    **Only this checkout's records are named.** Another line's mutation is
    that line's to put back, and listing it here sent a line to look at a tree
    it does not own. Its record is left exactly as it is.

    **A run whose process is still there is not reported either.**

    **An entry whose file already reads as its kept copy is not reported.**
    Somebody put it back — by hand, or some other way — and a tool that kept
    warning about a mutation that is no longer there would be a tool worth
    learning to ignore. Checked by the bytes, not by whether the tool did the
    restoring, because the operator restoring a file by hand is exactly as
    good an ending as this tool's own `finally` reaching it. An entry whose
    kept copy is itself gone cannot be verified or restored either way, so it
    is dropped rather than reported on evidence that no longer exists.

    Every entry still genuinely outstanding is kept on record, so it is
    reported again on the next invocation too, until it is actually resolved.
    """
    for record, checkout, pid, target, kept in _records():
        # **A run that is still going holds its mutation on purpose**, so it is
        # neither outstanding nor a record to prune: its file reads as its kept
        # copy until the run has mutated it, and pruning then would lose the
        # entry of a run that is about to be killed.
        if checkout != CHECKOUT or _running(pid):
            continue
        if not os.path.isfile(kept) or (
            os.path.isfile(target) and _same_bytes(target, kept)
        ):
            try:
                os.unlink(record)
            except FileNotFoundError:
                pass
            continue
        print(
            f"SABOTAGE OUTSTANDING: {target} is still mutated from a run that never "
            f"restored it — an earlier sabotage was killed outright rather than ended. "
            f"Put it back with: cp {kept} {target}",
            flush=True,
        )


def _same_bytes(one, other):
    with open(one, "rb") as a, open(other, "rb") as b:
        return a.read() == b.read()


def refuse(why):
    """**Say it on both streams.**

    Every other line this tool prints goes to stdout, and this one went to
    stderr alone — so a caller filtering stdout saw an empty screen and a tool
    that had done nothing. **A refusal that reads as silence is the worst of
    the four ways a verdict has been wrong**, because there is no contradiction
    to notice: nothing happened and nothing said so.

    Stderr keeps it too, so a caller already reading that stream is unaffected.
    """
    print(f"REFUSED: {why}", file=sys.stderr)
    print(f"SABOTAGE REFUSED: {why}", flush=True)
    return 2


# **What a cargo run says about itself, on the stream this tool keeps.**
#
# Measured rather than assumed: `test result:` is written to STDOUT and cargo's
# own progress — Compiling, Finished, Running — to STDERR. **So keeping stdout
# gets the marker and leaves the progress attached to the terminal**, which is
# why only one of the two streams is teed.
FAILED_CASE = "test result: FAILED"
ANY_RESULT = "test result:"
# **Every target's own count**, as the runner writes it: `test result: ok. 1
# passed; 0 failed; ...`. A filter that matches nothing leaves every target at
# `0 passed; 0 failed` and the exit code at zero.
TESTS_RUN = re.compile(r"^test result: \w+\. (\d+) passed; (\d+) failed;", re.MULTILINE)


def run_and_keep(command):
    """Run it, show every line as it arrives, and keep both streams.

    ⛔️ **Teed rather than captured.** `capture_output` shows the caller nothing
    until the run ends, and the run this tool is pointed at takes minutes — a
    tool that goes silent for that long is worse than the defect it is fixing.

    **Both streams are teed to where they were going**, and kept apart. Stdout
    carries the runner's results. Stderr carries cargo's own progress and its
    errors, and it was left attached to the terminal, which hid the one thing
    only it says: that a break did not compile. A person watching sees the same
    lines as before.
    """
    running = subprocess.Popen(
        command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
    )
    errored = []

    def tee_stderr():
        for line in running.stderr:
            print(line, end="", file=sys.stderr, flush=True)
            errored.append(line)

    watcher = threading.Thread(target=tee_stderr, daemon=True)
    watcher.start()
    kept = []
    for line in running.stdout:
        print(line, end="", flush=True)
        kept.append(line)
    running.wait()
    watcher.join()
    return running.returncode, "".join(kept), "".join(errored)


COULD_NOT_COMPILE = "error: could not compile"
# Its own exit code: not the refusal's 2, and not a runner's 1 or 101.
DID_NOT_COMPILE_EXIT = 3


def did_not_compile(code, said, errored):
    """**Whether the break stopped the build, so no test could have run.**

    Cargo says so on its own stderr, as a line of its own, and runs nothing
    after it. **Stderr alone is read for the line**: a test that fails with the
    compiler's words in its own output is a failed case, and its output arrives
    on stdout. **A run that exited zero is never a failed build**, whatever it
    printed: a case that expects another crate not to compile passes and shows
    the compiler's error on its way. A pure function over the exit code and the
    two streams, self-checked like the classifier beside it.
    """
    if code == 0:
        return False
    return any(line.startswith(COULD_NOT_COMPILE) for line in errored.splitlines())


def ran_nothing(said):
    """**Whether the output says the run executed no test at all.**

    A filter that matches nothing makes the runner exit zero, so a run that
    measured nothing read as GREEN — and the probe after it, which stays green
    under a panic when no test runs, read as a site the case is BLIND to.
    **The count is the sum over every target**, because most targets of a run
    that did test something ran nothing. Silence when the output carries no
    count at all: a runner this knows nothing about gets no opinion.
    """
    counts = [int(passed) + int(failed) for passed, failed in TESTS_RUN.findall(said)]
    return bool(counts) and sum(counts) == 0


def disagrees(code, said):
    """**How many targets the output says failed, when the code says none.**

    A pure function over the exit code and the text, because it is the part
    that decides — and the classifier beside it is self-checked for the same
    reason. `None` is no opinion.
    """
    if code != 0 or ANY_RESULT not in said:
        return None
    failed = sum(1 for line in said.splitlines() if line.startswith(FAILED_CASE))
    return failed or None


def disagreement(code, said):
    """**Say when the exit code and the output disagree.**

    A verdict is the exit code of the command it was handed, and a caller who
    pipes that command hands over the pipe's code instead — so the tool reports
    GREEN over a wall of failures it never saw. **It has never seen them
    because it never held the output**; now it does, and it can say when the
    two do not match.

    ⛔️ **It reports and never gates.** The exit code is still the verdict, and
    a caller may have reasons this cannot see.

    **Silence rather than a guess.** Output carrying no `test result:` line at
    all is a runner this knows nothing about, and an opinion there would be one
    somebody has to learn to ignore.
    """
    failed = disagrees(code, said)
    if failed is None:
        return
    print(
        f"SABOTAGE DISAGREES: the command exited 0 and its own output says {failed} "
        "target(s) FAILED. The verdict above is the exit code of what you handed this tool — "
        "a pipe reports its own. Read the count, not the code.",
        flush=True,
    )


def main(argv):
    report_outstanding()
    broken = self_check()
    if broken:
        return refuse(broken)
    if argv == ["--self-check"]:
        print(
            f"SABOTAGE SELF-CHECK: {len(CHECKS)} classifier, {len(DISAGREEMENTS)} "
            f"disagreement and {len(COMPILES)} compile cases hold"
        )
        return 0
    if "--" not in argv:
        return refuse(USAGE)
    split = argv.index("--")
    named, command = argv[:split], argv[split + 1 :]
    if len(named) != 3 or not command:
        return refuse(USAGE)
    path, old, new = named

    if not os.path.isfile(path):
        return refuse(f"{path} is no file")
    before = open(path, encoding="utf-8").read()

    # **The site has to be the one you meant.** A needle matching twice is a
    # sabotage that will land somewhere, move something, and report a verdict
    # about whichever site it happened to hit.
    found = before.count(old)
    if found != 1:
        return refuse(
            f"the text to replace appears {found} times in {path} and it has to appear once, "
            f"so the sabotage lands where you meant it to"
        )
    after = before.replace(old, new, 1)
    if after == before:
        return refuse("the replacement leaves the file unchanged, so nothing would be sabotaged")

    kept = tempfile.NamedTemporaryFile(
        prefix="sabotage-", suffix=os.path.basename(path), delete=False
    ).name
    shutil.copyfile(path, kept)
    print(f"SABOTAGE {path}: kept at {kept}", flush=True)
    # **Written before the mutation below, on purpose.** A hard kill of this
    # process can land at any point after this line, and the one thing every
    # such ending has in common is that this record must already be true.
    mark_in_flight(os.path.abspath(path), kept)

    # **Asked to stop is a way of ending, not a way of skipping the restore.**
    # Turning the signal into an exception is what lets one `finally` cover
    # every ending this process has.
    def stop(number, _frame):
        raise SystemExit(128 + number)

    for asked in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(asked, stop)

    try:
        with open(path, "w", encoding="utf-8") as writing:
            writing.write(after)
        # **Read back rather than trusted.** The write is what the verdict
        # below is a verdict about, and a write that did not land would make
        # every run after it a report on code nobody changed.
        applied = open(path, encoding="utf-8").read()
        if applied != after:
            return refuse(f"{path} did not take the sabotage, so no verdict here means anything")
        print(f"SABOTAGE APPLIED to the one site in {path}", flush=True)

        code, said, errored = run_and_keep(command)
        # **Before any verdict, and before the empty-run check**: a break that did
        # not compile measured nothing, and calling it RED reads as a case that
        # caught the break. It has no colour, no probe, and an exit code of its own.
        if did_not_compile(code, said, errored):
            print(
                f"SABOTAGE VERDICT DID NOT COMPILE: {' '.join(command)} exited {code}. "
                "The break does not build, so no case ran and none was measured: this is "
                "neither RED nor GREEN. Read the compiler's error above and fix the break.",
                flush=True,
            )
            return DID_NOT_COMPILE_EXIT
        # **Before any verdict**: a run that tested nothing has none to give.
        if ran_nothing(said):
            return refuse(
                f"no test ran under `{' '.join(command)}`, so there is no verdict. A test "
                "filter that matches nothing does this: check the name it was given."
            )
        verdict = "RED" if code != 0 else "GREEN"
        print(
            f"SABOTAGE VERDICT {verdict}: {' '.join(command)} exited {code}",
            flush=True,
        )
        disagreement(code, said)
        if code == 0:
            probe(path, before, old, command)
        return code
    finally:
        shutil.copyfile(kept, path)
        os.unlink(kept)
        clear_in_flight(os.path.abspath(path), kept)
        print(f"SABOTAGE RESTORED {path}", flush=True)


# **What the probe puts at the site.** The marker is ours rather than the
# runner's, which is what lets a probe that panicked be told from a probe that
# would not compile: both leave a non-zero exit code, and only one of them says
# this.
#
# ⚠️ **Finding the marker anywhere in the output is not enough, and reading it
# that way got the first run of this wrong.** A compiler warning quotes the
# source line it is about, marker and all, so a probe that compiled with a
# warning and never fired was read as having fired. **A panic prints its
# message as a line of its own**, where a quoted source line always carries the
# compiler's gutter — so the test is a whole line rather than a substring.
MARKER = "SABOTAGE-PROBE-REACHED-THIS-SITE"
PANIC = f'panic!("{MARKER}")'


def probe_text(old):
    """**A `panic!` that can stand where `old` stood**, or `None`.

    Two shapes, because two cover nearly every site a sabotage names and a
    third rule would be guessing at Rust with a regular expression.

    `key: value,` keeps its key and its comma: a struct field replaced whole
    leaves the field missing and the literal broken. Anything else becomes the
    panic alone, keeping a trailing comma or semicolon if there was one.

    **Neither shape is checked for sense here.** Whether it compiles is the
    compiler's answer, and the run below reports it as one.
    """
    body = old.rstrip()
    if not body.strip():
        return None
    lead = body[: len(body) - len(body.lstrip())]
    tail = body[-1] if body[-1:] in ",;" else ""
    inner = body.strip().rstrip(",;")
    key, colon, _ = inner.partition(":")
    if colon and key.strip().replace("_", "").isalnum() and "\n" not in key:
        return f"{lead}{key.strip()}: {PANIC}{tail or ','}"
    if "\n" in body:
        return None
    return f"{lead}{PANIC}{tail}"


DEPENDED_ON = "DEPENDED ON"
BLIND = "BLIND"
NOT_MEASURED = "NOT MEASURED"

SAYS = {
    DEPENDED_ON: (
        "DEPENDED ON — a panic here is noticed, so the green above is a genuine negative "
        "control and says something about the code"
    ),
    BLIND: (
        "BLIND — a panic here is not noticed, so the green above measured NOTHING. The case "
        "does not depend on this site; sabotage the one it does."
    ),
    NOT_MEASURED: (
        "NOT MEASURED — the probe did not run and did not panic, so this says nothing either "
        "way. The output above is why; usually the panic could not be written where the site "
        "stands."
    ),
}


def classify(said, returncode):
    """**Which kind of green, from the probe's output and its exit code.**

    A pure function over strings, because it is the part that has been wrong:
    the first version asked whether the marker appeared anywhere in the output
    and was fooled by the compiler quoting the very line it had just been asked
    to compile. **A panic prints its message as a line of its own**, and a
    quoted source line always carries the compiler's gutter, so the test is a
    whole line rather than a substring.

    A run that neither panicked nor succeeded says nothing: usually the panic
    could not be written where the site stands. **Reporting that as BLIND would
    tell somebody their case is worthless when nothing was measured.**
    """
    if any(line.strip() == MARKER for line in said.splitlines()):
        return DEPENDED_ON
    return BLIND if returncode == 0 else NOT_MEASURED


# **The four inputs are real output, kept as it arrived.** The first is what
# actually fooled this classifier: the probe compiled, warned, never fired, and
# the compiler echoed the marker back inside a quoted source line. A
# reconstruction of that would have been written by somebody who already knew
# the answer.
CHECKS = (
    (
        "the compiler echoing the marker in a warning is not a panic",
        'warning: unreachable expression\n'
        '1247 | | ...                       retracted: panic!("SABOTAGE-PROBE-REACHED-THIS-SITE"),\n'
        "warning: `jojobot-domain` (lib) generated 2 warnings\n",
        0,
        BLIND,
    ),
    (
        "a panic prints its message as a line of its own",
        "thread 'memory::graph::tests::the_scopes_part_company' (3901737) panicked at "
        "crates/jojobot-domain/src/memory/graph.rs:218:9:\n"
        "SABOTAGE-PROBE-REACHED-THIS-SITE\n"
        "note: run with `RUST_BACKTRACE=1` environment variable to display a backtrace\n",
        101,
        DEPENDED_ON,
    ),
    (
        "a clean pass with the marker nowhere is blind",
        "test result: ok. 1 passed; 0 failed; 0 ignored; 189 filtered out\n",
        0,
        BLIND,
    ),
    (
        "a probe that would not compile measured nothing",
        "error: expected one of `,` or `}`, found `panic`\n"
        "error: could not compile `jojobot-domain` (lib test)\n",
        101,
        NOT_MEASURED,
    ),
)


# **What the disagreement reads, kept as the runner really writes it.** The
# first is the shape that has printed GREEN over a wall of failures all day.
DISAGREEMENTS = (
    (
        "a pipe hands over its own code and the output still says FAILED",
        0,
        "running 3 tests\ntest a ... FAILED\ntest result: FAILED. 2 passed; 1 failed\n",
        1,
    ),
    (
        "a genuinely green run is not a disagreement",
        0,
        "running 3 tests\ntest result: ok. 3 passed; 0 failed\n",
        None,
    ),
    (
        "a runner this knows nothing about gets no opinion",
        0,
        "hello\n",
        None,
    ),
    (
        "a red verdict needs no second opinion, whatever the output says",
        101,
        "test result: FAILED. 2 passed; 1 failed\n",
        None,
    ),
)


# **What a break that did not build looks like, as cargo wrote it** — the first
# is the stderr of a sabotage that put an integer where a `&str` constant stood.
# The others are the runs that must not be mistaken for it.
COMPILES = (
    (
        "a break that does not build stops the run at cargo's own line",
        101,
        "",
        "   Compiling jojobot-bar v0.1.0 (/x/crates/jojobot-bar)\n"
        "error[E0308]: mismatched types\n"
        "92 | pub const TEST_JOBS_VARIABLE: &str = 7;\n"
        "error: could not compile `jojobot-bar` (lib test) due to 1 previous error\n",
        True,
    ),
    (
        "a case that failed is a failed case",
        101,
        "running 1 test\ntest a ... FAILED\n"
        "test result: FAILED. 0 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out\n",
        "    Finished `test` profile [unoptimized + debuginfo] target(s) in 1.00s\n",
        False,
    ),
    (
        "a failed case that quotes the compiler's line is still a failed case",
        101,
        "test a ... FAILED\nerror: could not compile `x` (lib test)\n"
        "test result: FAILED. 0 passed; 1 failed; 0 ignored; 0 measured; 0 filtered out\n",
        "",
        False,
    ),
    (
        "a quoted line on stdout alone, with no result line, is not cargo's own",
        101,
        "error: could not compile `x` (lib test)\n",
        "",
        False,
    ),
    (
        "a run that exited zero is not a failed build, whatever stderr shows",
        0,
        "",
        "error: could not compile `fixture` (lib) due to 1 previous error\n",
        False,
    ),
    (
        "a run that compiled with a warning is not a failed build",
        0,
        "test result: ok. 1 passed; 0 failed; 0 ignored; 0 measured; 0 filtered out\n",
        "warning: `jojobot-domain` (lib) generated 2 warnings\n",
        False,
    ),
)


def self_check():
    """**The classifier answers for itself before it answers about anything.**

    It runs on every sabotage rather than in the bar, because the moment it is
    about to be relied on is the moment worth checking it — and because it is
    four string comparisons.

    ⛔️ **A broken classifier is not a silence to fall back to.** It prints
    DEPENDED ON over a blind case, which is an active mis-certification of the
    one thing this tool exists to catch, so a failure here refuses rather than
    warns.
    """
    for why, said, code, wanted in CHECKS:
        got = classify(said, code)
        if got != wanted:
            return f"the probe classifier is wrong — {why}: said {got}, and it has to say {wanted}"
    for why, code, said, wanted in DISAGREEMENTS:
        got = disagrees(code, said)
        if got != wanted:
            return (
                f"the disagreement check is wrong — {why}: said {got}, and it has to say {wanted}"
            )
    for why, code, said, errored, wanted in COMPILES:
        got = did_not_compile(code, said, errored)
        if got != wanted:
            return f"the compile check is wrong — {why}: said {got}, and it has to say {wanted}"
    return None


def probe(path, before, old, command):
    """**Which kind of green that was**, printed and never enforced."""
    text = probe_text(old)
    if text is None:
        print(
            "SABOTAGE PROBE SKIPPED: no panic can be written at this site, so which kind of "
            "green this is was not measured",
            flush=True,
        )
        return
    print(
        "SABOTAGE PROBING which kind of green: a panic at the same site, same command. "
        "This roughly doubles the run.",
        flush=True,
    )
    with open(path, "w", encoding="utf-8") as writing:
        writing.write(before.replace(old, text, 1))
    ran = subprocess.run(command, capture_output=True, text=True)
    if ran_nothing(ran.stdout + ran.stderr):
        print(
            "SABOTAGE PROBE EMPTY: the probe run executed no test, so which kind of green "
            "this is was not measured",
            flush=True,
        )
        return
    verdict = classify(ran.stdout + ran.stderr, ran.returncode)
    if verdict == NOT_MEASURED:
        print(ran.stdout + ran.stderr, flush=True)
    print(f"SABOTAGE PROBE: {SAYS[verdict]}", flush=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
